<?grd
namespace BenchSql\Http\Middleware;

use OpenGrid\Database\DB;
use OpenGrid\Http\Middleware;
use OpenGrid\Http\Request;
use OpenGrid\Http\Response;

/**
 * Measurement tool (D23): the token check of the framework-core benchmark,
 * the same statements as in the Laravel app. The token's use is written at
 * most once a second, as Sanctum does in effect.
 */
final class BenchToken extends Middleware
{
    public function handle(Request $request, \Closure $next): mixed
    {
        $token = $request->bearerToken();
        if (!is_string($token) || $token === '') {
            return Response::json(['message' => 'Unauthenticated.'], 401);
        }
        $db = DB::connection('bench_sqlite');
        $rows = $db->select('SELECT t.id AS token_id, t.last_used_at, u.id, u.name, u.email FROM tokens t JOIN users u ON u.id = t.user_id WHERE t.token_hash = ? LIMIT 1', [hash('sha256', $token)]);
        if (count($rows) === 0) {
            return Response::json(['message' => 'Unauthenticated.'], 401);
        }
        $row = $rows[0];
        $now = time();
        if ($now - $row['last_used_at'] >= 1) {
            $db->update('UPDATE tokens SET last_used_at = ? WHERE id = ?', [$now, $row['token_id']]);
        }
        $request->setUser(['id' => $row['id'], 'name' => $row['name'], 'email' => $row['email']]);
        return $next($request);
    }
}
