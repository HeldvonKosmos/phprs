<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- BENCH3: every package version locked (packages.lock.json) -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- the ADO.NET provider without a bundled SQLite; the provider loads the
         system's libsqlite3 (the benchmark's 3.45.2 through LD_LIBRARY_PATH) -->
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.14" />
    <PackageReference Include="SQLitePCLRaw.provider.sqlite3" Version="3.0.5" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.1" />
  </ItemGroup>

</Project>
