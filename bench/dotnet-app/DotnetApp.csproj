<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- BENCH3: every package version locked (packages.lock.json) -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- BENCH3 (Jonas, 28.10.): the code precompiled to native (ReadyToRun) for
         a fast start; tiered compilation with PGO re-optimizes the hot paths -->
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <!-- the ADO.NET provider without a bundled SQLite; the provider loads the
         system's libsqlite3 (the benchmark's 3.53.4 through LD_LIBRARY_PATH) -->
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.14" />
    <PackageReference Include="SQLitePCLRaw.provider.sqlite3" Version="3.0.5" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.1" />
  </ItemGroup>

</Project>
