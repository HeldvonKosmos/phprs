#!/usr/bin/env bash
# Commit rule (CLAUDE.md rule 1, D18): no commit without a green suite.
# tools/commit.sh has just tested the staged tree and says so through
# OPENGRID_GREEN_TREE; any other `git commit` runs the suite here.
# Enable once per clone: git config core.hooksPath .githooks
cd "$(git rev-parse --show-toplevel)" || exit 1
# dependencies and build output of the comparison apps never go into the
# repository (cf7db20 committed a node_modules by mistake)
bad=$(git diff --cached --name-only --diff-filter=AM | grep -E '(^|/)(node_modules|\.venv|_build|deps|dist|obj|target)/|(^|/)bench/[^/]+-app/build/|(^|/)bin/(Debug|Release)/|\.tsbuildinfo$' | head -5)
if [ -n "$bad" ]; then
    echo "pre-commit: dependency or build files are staged (add them to the app's .gitignore):" >&2
    echo "$bad" >&2
    exit 1
fi
if [ -n "${OPENGRID_GREEN_TREE:-}" ] && [ "$OPENGRID_GREEN_TREE" = "$(git write-tree)" ]; then
    exit 0
fi
echo "pre-commit: running the suite (tools/green.sh); this takes a few minutes"
tools/green.sh | tail -1
exit "${PIPESTATUS[0]}"
