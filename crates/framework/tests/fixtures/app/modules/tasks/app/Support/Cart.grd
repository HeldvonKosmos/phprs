<?grd
namespace Tasks\Support;

/** SES1: an object kept with the session (`Session::remember`). */
final class Cart
{
    private array $items = [];

    public function __construct(public string $owner) {}

    public function add(string $item): void
    {
        $this->items[] = $item;
    }

    public function items(): array
    {
        return $this->items;
    }
}
