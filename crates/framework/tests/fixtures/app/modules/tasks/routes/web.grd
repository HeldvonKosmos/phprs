<?grd
use OpenGrid\Routing\Route;
use Tasks\Controllers\TaskController;
use Tasks\Http\Middleware\RequireToken;

Route::get('/tasks', [TaskController::class, 'index']);
Route::get('/tasks/{id}', [TaskController::class, 'show']);
Route::post('/tasks', [TaskController::class, 'store']);
Route::get('/hello', [TaskController::class, 'hello']);
Route::get('/echoed', [TaskController::class, 'echoed']);
Route::get('/boom', [TaskController::class, 'boom']);
Route::get('/old', [TaskController::class, 'redirect']);
Route::get('/db', [TaskController::class, 'db']);
Route::get('/tasks-filter', [TaskController::class, 'filtered']);
Route::get('/fail', [TaskController::class, 'notFound']);

Route::aliasMiddleware('token', RequireToken::class);
Route::group(['prefix' => '/admin', 'middleware' => ['token']], function () {
    Route::get('/tasks', [TaskController::class, 'index'])->name('admin.tasks');
    Route::post('/tasks', [TaskController::class, 'validated']);
});
