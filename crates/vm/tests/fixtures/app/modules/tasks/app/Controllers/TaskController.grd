<?grd
namespace Tasks\Controllers;

use Tasks\Services\TaskRepository;

class TaskController extends BaseController
{
    public function __construct(private TaskRepository $repo = new TaskRepository()) {}

    public function index(): array
    {
        $this->repo->add('write the autoloader');
        $this->repo->add('load the project');
        return $this->respond(['ok' => true, 'tasks' => $this->repo->all()]);
    }
}
