<?grd
// PERF2: intdiv, abs, max, min on integers run inline in the interpreter;
// edge cases and other types must behave exactly as before (and as PHP).
function show(mixed $v): void { var_dump($v); }
show(intdiv(7, 2)); show(intdiv(-7, 2)); show(intdiv(7, -2)); show(intdiv(-7, -2));
show(intdiv(PHP_INT_MAX, 1)); show(intdiv(PHP_INT_MIN, 1));
show(abs(-5)); show(abs(0)); show(abs(PHP_INT_MIN + 1)); show(abs(-2.5));
show(max(3, 9)); show(max(9, 3)); show(max(-1, -1)); show(max(2, 2.5)); show(max([4, 8, 1]));
show(min(3, 9)); show(min(9, 3)); show(min(PHP_INT_MIN, 0)); show(min(2.5, 2)); show(min('b', 'a'));
try { intdiv(1, 0); } catch (DivisionByZeroError $e) { echo get_class($e), ': ', $e->getMessage(), "\n"; }
try { intdiv(PHP_INT_MIN, -1); } catch (ArithmeticError $e) { echo get_class($e), ': ', $e->getMessage(), "\n"; }
$s = 0;
for ($i = 1; $i <= 1000; $i++) { $s += intdiv($i * 7, 3) + abs($i - 500) + max($i, 300) - min($i, 700); }
echo $s, "\n";
