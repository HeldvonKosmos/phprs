<?grd
// MUT2: edges of the value core that mutation testing found unchecked:
// numeric strings, truthiness of floats, casts of arrays, float output at
// the format boundaries, canonical integer keys, === on floats outside the
// fast path, nested appends. Output is PHP's.
function show(mixed $v): string { return var_export($v, true); }
foreach (['.', '+', '-', '+.', '.5', '5.', '-.5e3', '1e', '1e+', '1e5', '1E-2', ' 12', '12 ', "\n12\t", '0x1A', '1_000', '1.5.3', '+-1', 'e5', '   ', '', '007', '-0', '9223372036854775807', '9223372036854775808', ' .', '5e', '5.e3', '.e3', '1e3x', '12abc', '0.0'] as $s) {
    echo json_encode($s), ' ', show(is_numeric($s)), ' ', show((int) $s), ' ', show((float) $s), "\n";
}
function truth(mixed $v): string { return ($v ? 'T' : 'F') . (!$v ? 'n' : 'y') . ((bool) $v ? '1' : '0'); }
foreach ([0.0, -0.0, 0.5, -1.5, 1e-300, NAN, INF, 0, 7, '', '0', '0.0', 'a', [], [0], null] as $v) {
    echo truth($v), ' ';
}
echo "\n", show((int) []), show((int) [5, 6]), show((float) []), show((float) [5]), "\n";
foreach ([1e14, 99999999999999.0, 1e15, 999999999999999.0, 1e16, 1e-4, 1e-5, 0.0001, 0.00001, 123456789012345.67, -1e14, -1e-5, 1.5e300, INF, -INF, 0.1 + 0.2, 1/3, 1e22] as $f) {
    echo $f, ' | ', var_export($f, true), ' | ', json_encode($f), ' | ';
    var_dump($f);
}
$k = [];
foreach (['0', '-0', '00', '-', '1', '-1', '01', '9223372036854775807', '9223372036854775808', '-9223372036854775808', '-9223372036854775809', ' 1', '1 ', '+1', '1.0'] as $s) { $k[$s] = $s; }
var_dump(array_keys($k));
function ident(mixed $a, mixed $b): string { return show($a === $b); }
echo ident(1.5, 1.5), ident(1.5, 1.50), ident(0.0, -0.0), ident(NAN, NAN), ident([1.5, 2.0], [1.5, 2.0]), ident([1.5], [1.6]), ident(1.0, 1), "\n";
var_dump(in_array(2.5, [1, 2.5], true), array_search(0.5, [0.25, 0.5], true), [1.5] === [1.5]);
$n = [];
$n[][] = 1;
$n[]['x'] = 2;
$n[0][] = 3;
$n['k'][][] = 4;
echo json_encode($n), "\n";
