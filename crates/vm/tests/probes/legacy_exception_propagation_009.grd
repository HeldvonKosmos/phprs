        function normal() {
            try {
                return "fine";
            } catch (Exception $e) {
                return "wrong";
            }
        }
        function thrower() {
            throw new Exception("later");
        }
        echo normal();
        try {
            thrower();
        } catch (Exception $e) {
            echo " then " . $e->getMessage();
        }
