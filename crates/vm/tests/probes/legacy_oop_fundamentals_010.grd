class M { public function s(string $n, ...$a) { return $n . count($a); } public static function t(string $n, ...$a) { return $n . count($a); } }
$m = new M; echo $m->s("x"), $m->s("x", 1), $m->s("x", 1, 2), M::t("y"), M::t("y", 1, 2);
