<?grd
// range() as in PHP 8.4: finite arguments, step sign, size limit, no overflow,
// integer results for an integral float step, one-byte strings as characters.
foreach ([[1,5,-1],[5,1,-1],[5,1,2],[0,1,0.25],[1,2,INF],[INF,1,1],[NAN,1,1],[1,5,0],[PHP_INT_MAX-1,PHP_INT_MAX,1],[PHP_INT_MIN,PHP_INT_MIN+2,1],[0.0, 2.0, -0.5],[2.0,0.0,-0.5],["a","e",2],["e","a",-2],["a","e",-1],[1, 2, PHP_INT_MIN],[1,10,3.0],[1,10,2.5],[1,2,0.3],[0, 100_000_000_000, 0.1],[PHP_INT_MIN, PHP_INT_MAX, 1],["1","3"],["1.5","3"]] as $c) { try { $r = range(...$c); echo json_encode($c), " => ", count($r) < 8 ? json_encode($r) : count($r), "\n"; } catch (\Throwable $e) { echo json_encode($c), " => ", get_class($e), ": ", $e->getMessage(), "\n"; } }
