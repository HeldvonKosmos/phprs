<?grd // SPDX-License-Identifier: Apache-2.0 (test harvested from yingkitw/phprs, see NOTICE)
$it = new ArrayIterator(["a" => 1, "b" => 2, "c" => 3]);
echo "count: " . $it->count() . "\n";
$it->rewind();
while ($it->valid()) {
    echo $it->key() . " => " . $it->current() . "\n";
    $it->next();
}
