function s(...$a) { return implode(",", $a); }
class M { public function i(...$a) { return count($a); } public static function t($x, ...$a) { return $x . ":" . count($a); } }
$v = [1, 2, 3]; $m = new M;
echo s(...$v), "|", s(0, ...$v), "|", s(...$v, ...$v), "|", $m->i(...$v), "|", M::t("k", ...$v), "|", (new M)->i(9, ...$v);
