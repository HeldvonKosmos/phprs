<?grd
// TEST2.8: the operators' general paths (ops.rs) that the int/float fast path
// of the interpreter loop does not take: compound assignment on array
// elements and properties, pow(), array_sum/array_product, comparisons of
// strings, arrays, bools and null, ++/-- on ints and floats, shifts at the
// edges. Output is PHP's; `%` and bit operations on floats and ++/-- on null
// are dialect errors (DIA2) and live in dialect_numeric_edges.
final class Box { public int $i = 10; public float $f = 2.5; public ?int $n = 0; public string $s = 'b'; }
$a = ['i' => 7, 'f' => 1.5, 'n' => 0, 'm' => 9];
$a['i'] += 5; $a['i'] -= 2; $a['i'] *= 3; $a['i'] %= 7; $a['i'] **= 3;
$a['f'] += 1; $a['f'] -= 0.25; $a['f'] *= 4; $a['f'] /= 2; $a['f'] **= 2;
$a['m'] &= 12; $a['m'] |= 3; $a['m'] ^= 5; $a['m'] <<= 3; $a['m'] >>= 1;
$a['n']++; $a['n']++; $a['f']--; $a['m']--;
var_dump($a);
$b = new Box();
$b->i += 3; $b->i -= 1; $b->i *= 2; $b->i %= 5; $b->i **= 2; $b->f /= 4; $b->f -= 1;
$b->n++; ++$b->n; $b->n--; $b->i++; --$b->i;
$b->s .= 'c';
var_dump($b);
$m = [1.5];
$m[0]++; $m[0]--; $m[0]--;
var_dump($m[0], pow(2, 10), pow(2, -1), pow(2.0, 3), pow(-1, 7), pow(-1, 8), pow(0, 5), pow(1, 200), pow(-2, 3));
var_dump(array_sum([1, 2, 3]), array_sum([1, 2.5]), array_sum([]), array_product([2, 3, 4]), array_product([2, 0.5]), array_product([]));
var_dump(7 % -3, -7 % 3, 5 % -1, PHP_INT_MIN % -1, intdiv(7, -2), 7 / 2, 7.0 / 2, -7 / 2.0);
var_dump(5 & 3, 5 | 2, 6 ^ 3, 1 << 0, 1 << 63, 1 << 64, 1 << 65, -8 >> 1, -8 >> 63, -8 >> 64, 8 >> 64, 3 << 2);
function cmp(mixed $x, mixed $y): string
{
    return json_encode($x) . ' ' . json_encode($y) . ': ' . var_export($x < $y, true) . ' ' . var_export($x <= $y, true) . ' ' . var_export($x > $y, true) . ' ' . var_export($x >= $y, true) . ' ' . ($x <=> $y) . ' ' . var_export($x === $y, true) . ' ' . var_export($x !== $y, true) . "\n";
}
foreach ([['a', 'b'], ['b', 'a'], ['a', 'a'], ['abc', 'abd'], ['', 'a'], ['B', 'a'], [1.5, 1], [2, 1.5], [1, 1.0], [-0.0, 0], [PHP_INT_MAX, 9.3e18]] as $pair) {
    echo cmp($pair[0], $pair[1]);
}
$s = ['a' => 'x'];
$s['a'] .= 'y';
echo $s['a'], ' ', -(-5), ' ', -(2.5), ' ', +3, "\n";
foreach ([fn () => 1 % 0, fn () => 1 / 0, fn () => intdiv(1, 0), fn () => 1 << -1, fn () => 1 >> -1, fn () => 1.5 / 0.0, fn () => [] + 1, fn () => [] - 1, fn () => 2 * [], fn () => [] / 1, fn () => [] % 2, fn () => [] ** 2, fn () => null + [], fn () => [] & 1] as $f) {
    try { var_dump($f()); } catch (Throwable $e) { echo get_class($e), ': ', $e->getMessage(), "\n"; }
}
// the same operators on run-time values (no constant folding)
function ops(mixed $x, mixed $y): string
{
    $r = [];
    foreach (['+', '-', '*', '%', '**', '&', '|', '^', '<<', '>>', '<', '<=', '>', '>=', '<=>', '==='] as $op) {
        try {
            $v = match ($op) {
                '+' => $x + $y, '-' => $x - $y, '*' => $x * $y, '%' => $x % $y, '**' => $x ** $y,
                '&' => $x & $y, '|' => $x | $y, '^' => $x ^ $y, '<<' => $x << $y, '>>' => $x >> $y,
                '<' => $x < $y, '<=' => $x <= $y, '>' => $x > $y, '>=' => $x >= $y, '<=>' => $x <=> $y, '===' => $x === $y,
            };
            $r[] = $op . '=' . var_export($v, true);
        } catch (Throwable $e) {
            $r[] = $op . '!' . get_class($e);
        }
    }
    return implode(' ', $r) . "\n";
}
foreach ([[5, 4], [6, 3], [7, 0], [-9, 2], [1, 0], [0, 64], [-1, 63], [12, 10], [3, -1]] as $p) {
    echo ops($p[0], $p[1]);
}
function powers(int $base, int $exp): string { return var_export(pow($base, $exp), true) . ' ' . var_export($base ** $exp, true); }
echo powers(1, 5000000000), ' ', powers(-1, 5000000001), ' ', powers(-1, 5000000000), ' ', powers(0, 5000000000), ' ', powers(3, 4), ' ', powers(2, -2), "\n";
$d1 = new DateTimeImmutable('2020-01-01 00:00:00');
$d2 = new DateTimeImmutable('2021-06-01 12:00:00');
var_dump($d1 < $d2, $d1 > $d2, $d1 <= $d1, $d2 >= $d1, $d1 <=> $d2, $d2 <=> $d1);
var_export([PHP_INT_MIN, -PHP_INT_MAX, PHP_INT_MAX]);
// MUT2: integer division on the general path (compound assignment on an element)
$q = ['q' => 7, 'r' => -9];
$q['q'] /= 2;
$q['r'] /= 4;
var_dump($q);
