<?grd
// OpenGrid\Support (S1, core): Str, Arr and Collection in the dialect,
// behaving like Laravel's Illuminate\Support (R3 as the specification; the
// spec test runs Laravel's own classes from refs/ and compares). The dialect
// has no references: Arr::set/forget return the new array.
namespace OpenGrid\Support;

final class Str
{
    public static function lower(string $value): string { return mb_strtolower($value); }
    public static function upper(string $value): string { return mb_strtoupper($value); }
    public static function title(string $value): string { return mb_convert_case($value, MB_CASE_TITLE); }
    public static function length(string $value): int { return mb_strlen($value); }
    public static function ucfirst(string $value): string { return mb_strtoupper(mb_substr($value, 0, 1)) . mb_substr($value, 1); }
    public static function lcfirst(string $value): string { return mb_strtolower(mb_substr($value, 0, 1)) . mb_substr($value, 1); }

    public static function studly(string $value): string
    {
        $words = explode(' ', str_replace(['-', '_'], ' ', $value));
        $out = '';
        foreach ($words as $w) { $out .= self::ucfirst($w); }
        return $out;
    }

    public static function camel(string $value): string { return lcfirst(self::studly($value)); }

    public static function snake(string $value, string $delimiter = '_'): string
    {
        if (!ctype_lower($value)) {
            $value = preg_replace('/\s+/u', '', ucwords($value));
            $value = mb_strtolower(preg_replace('/(.)(?=[A-Z])/u', '$1' . $delimiter, $value));
        }
        return $value;
    }

    public static function kebab(string $value): string { return self::snake($value, '-'); }

    public static function slug(string $title, string $separator = '-'): string
    {
        $flip = $separator === '-' ? '_' : '-';
        $title = preg_replace('![' . preg_quote($flip) . ']+!u', $separator, $title);
        $title = str_replace('@', $separator . 'at' . $separator, $title);
        $title = preg_replace('![^' . preg_quote($separator) . '\pL\pN\s]+!u', '', mb_strtolower($title));
        $title = preg_replace('![' . preg_quote($separator) . '\s]+!u', $separator, $title);
        return trim($title, $separator);
    }

    public static function contains(string $haystack, string|array $needles, bool $ignoreCase = false): bool
    {
        if ($ignoreCase) { $haystack = mb_strtolower($haystack); }
        foreach ((array) $needles as $needle) {
            $n = $ignoreCase ? mb_strtolower((string) $needle) : (string) $needle;
            if ($n !== '' && str_contains($haystack, $n)) { return true; }
        }
        return false;
    }

    public static function containsAll(string $haystack, array $needles, bool $ignoreCase = false): bool
    {
        foreach ($needles as $needle) {
            if (!self::contains($haystack, (string) $needle, $ignoreCase)) { return false; }
        }
        return true;
    }

    public static function startsWith(string $haystack, string|array $needles): bool
    {
        foreach ((array) $needles as $needle) {
            if ((string) $needle !== '' && str_starts_with($haystack, (string) $needle)) { return true; }
        }
        return false;
    }

    public static function endsWith(string $haystack, string|array $needles): bool
    {
        foreach ((array) $needles as $needle) {
            if ((string) $needle !== '' && str_ends_with($haystack, (string) $needle)) { return true; }
        }
        return false;
    }

    public static function limit(string $value, int $limit = 100, string $end = '...'): string
    {
        if (mb_strwidth($value) <= $limit) { return $value; }
        return rtrim(mb_substr($value, 0, $limit)) . $end;
    }

    public static function words(string $value, int $words = 100, string $end = '...'): string
    {
        $m = preg_match('/^\s*+(?:\S++\s*+){1,' . $words . '}/u', $value);
        if ($m === [] || mb_strlen($value) === mb_strlen($m[0])) { return $value; }
        return rtrim($m[0]) . $end;
    }

    public static function after(string $subject, string $search): string
    {
        if ($search === '') { return $subject; }
        $parts = explode($search, $subject, 2);
        return $parts[count($parts) - 1];
    }

    public static function afterLast(string $subject, string $search): string
    {
        if ($search === '') { return $subject; }
        $pos = strrpos($subject, $search);
        return $pos === false ? $subject : substr($subject, $pos + strlen($search));
    }

    public static function before(string $subject, string $search): string
    {
        if ($search === '') { return $subject; }
        $result = strstr($subject, $search, true);
        return $result === false ? $subject : $result;
    }

    public static function beforeLast(string $subject, string $search): string
    {
        if ($search === '') { return $subject; }
        $pos = mb_strrpos($subject, $search);
        return $pos === false ? $subject : mb_substr($subject, 0, $pos);
    }

    public static function between(string $subject, string $from, string $to): string
    {
        if ($from === '' || $to === '') { return $subject; }
        return self::beforeLast(self::after($subject, $from), $to);
    }

    public static function replace(string|array $search, string|array $replace, string $subject): string
    {
        return str_replace($search, $replace, $subject);
    }

    public static function replaceFirst(string $search, string $replace, string $subject): string
    {
        if ($search === '') { return $subject; }
        $pos = strpos($subject, $search);
        return $pos === false ? $subject : substr_replace($subject, $replace, $pos, strlen($search));
    }

    public static function start(string $value, string $prefix): string
    {
        return $prefix . preg_replace('/^(?:' . preg_quote($prefix, '/') . ')+/u', '', $value);
    }

    public static function finish(string $value, string $cap): string
    {
        return preg_replace('/(?:' . preg_quote($cap, '/') . ')+$/u', '', $value) . $cap;
    }

    public static function is(string|array $pattern, string $value): bool
    {
        foreach ((array) $pattern as $p) {
            $p = (string) $p;
            if ($p === $value) { return true; }
            $regex = str_replace('\*', '.*', preg_quote($p, '#'));
            if (preg_match('#^' . $regex . '\z#u', $value) !== []) { return true; }
        }
        return false;
    }

    public static function squish(string $value): string
    {
        return preg_replace('~\s+~u', ' ', trim($value));
    }

    public static function padLeft(string $value, int $length, string $pad = ' '): string { return str_pad($value, $length, $pad, STR_PAD_LEFT); }
    public static function padRight(string $value, int $length, string $pad = ' '): string { return str_pad($value, $length, $pad, STR_PAD_RIGHT); }
    public static function padBoth(string $value, int $length, string $pad = ' '): string { return str_pad($value, $length, $pad, STR_PAD_BOTH); }

    public static function isUuid(string $value): bool
    {
        return preg_match('/^[\da-fA-F]{8}-[\da-fA-F]{4}-[\da-fA-F]{4}-[\da-fA-F]{4}-[\da-fA-F]{12}$/D', $value) !== [];
    }

    public static function isJson(string $value): bool { return json_validate($value); }

    public static function random(int $length = 16): string
    {
        $pool = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789';
        $out = '';
        for ($i = 0; $i < $length; $i++) { $out .= $pool[random_int(0, 61)]; }
        return $out;
    }

    /** Version 4 UUID. */
    public static function uuid(): string
    {
        $b = random_bytes(16);
        $hex = bin2hex($b);
        $variant = dechex((hexdec($hex[16]) & 3) | 8);
        return substr($hex, 0, 8) . '-' . substr($hex, 8, 4) . '-4' . substr($hex, 13, 3) . '-' . $variant . substr($hex, 17, 3) . '-' . substr($hex, 20, 12);
    }

    public static function mask(string $string, string $character, int $index, ?int $length = null): string
    {
        if ($character === '') { return $string; }
        $segment = mb_substr($string, $index, $length);
        if ($segment === '') { return $string; }
        $strlen = mb_strlen($string);
        $start = $index < 0 ? max(0, $strlen + $index) : $index;
        return mb_substr($string, 0, $start) . str_repeat(mb_substr($character, 0, 1), mb_strlen($segment)) . mb_substr($string, $start + mb_strlen($segment));
    }

    public static function wrap(string $value, string $before, ?string $after = null): string
    {
        return $before . $value . ($after ?? $before);
    }

    // ---- S1b ---------------------------------------------------------------

    public static function betweenFirst(string $subject, string $from, string $to): string
    {
        if ($from === '' || $to === '') { return $subject; }
        return self::before(self::after($subject, $from), $to);
    }

    public static function charAt(string $subject, int $index): string|false
    {
        $length = mb_strlen($subject);
        if ($index < 0 ? $index < -$length : $index > $length - 1) { return false; }
        return mb_substr($subject, $index, 1);
    }

    public static function chopStart(string $subject, string|array $needle): string
    {
        foreach ((array) $needle as $n) {
            if ($n !== '' && str_starts_with($subject, $n)) { return substr($subject, strlen($n)); }
        }
        return $subject;
    }

    public static function chopEnd(string $subject, string|array $needle): string
    {
        foreach ((array) $needle as $n) {
            if ($n !== '' && str_ends_with($subject, $n)) { return substr($subject, 0, -strlen($n)); }
        }
        return $subject;
    }

    public static function deduplicate(string $string, string|array $characters = ' '): string
    {
        foreach ((array) $characters as $c) {
            $string = preg_replace('/' . preg_quote($c, '/') . '+/u', $c, $string);
        }
        return $string;
    }

    public static function doesntContain(string $haystack, string|array $needles, bool $ignoreCase = false): bool { return !self::contains($haystack, $needles, $ignoreCase); }
    public static function doesntStartWith(string $haystack, string|array $needles): bool { return !self::startsWith($haystack, $needles); }
    public static function doesntEndWith(string $haystack, string|array $needles): bool { return !self::endsWith($haystack, $needles); }

    /** Text around the first occurrence of $phrase; omission marks cut text, null when not found. */
    public static function excerpt(string $text, string $phrase = '', array $options = []): ?string
    {
        $radius = (int) ($options['radius'] ?? 100);
        $omission = (string) ($options['omission'] ?? '...');
        $m = preg_match('/^(.*?)(' . preg_quote($phrase, '/') . ')(.*)$/iu', $text);
        if ($m === false || $m === []) { return null; }
        $before = ltrim((string) $m[1]);
        $start = ltrim(mb_substr($before, max(mb_strlen($before) - $radius, 0), $radius));
        if ($start !== $before) { $start = $omission . $start; }
        $after = rtrim((string) $m[3]);
        $end = rtrim(mb_substr($after, 0, $radius));
        if ($end !== $after) { $end = $end . $omission; }
        return $start . $m[2] . $end;
    }

    public static function toBase64(string $string): string { return base64_encode($string); }
    public static function fromBase64(string $string, bool $strict = false): string|false { return base64_decode($string, $strict); }

    public static function ucsplit(string $string): array { return preg_split('/(?=\p{Lu})/u', $string, -1, PREG_SPLIT_NO_EMPTY); }

    public static function headline(string $value): string
    {
        $parts = preg_split('/\s+/u', $value, -1, PREG_SPLIT_NO_EMPTY);
        $parts = count($parts) > 1 ? $parts : self::ucsplit(implode('_', $parts));
        $titled = [];
        foreach ($parts as $p) { $titled[] = self::title($p); }
        $collapsed = str_replace(['-', '_', ' '], '_', implode('_', $titled));
        return implode(' ', array_values(array_filter(explode('_', $collapsed), fn (string $w): bool => $w !== '')));
    }

    public static function isAscii(string $value): bool { return preg_match('/^[\x00-\x7F]*$/', $value) !== []; }

    public static function isMatch(string|array $pattern, string $value): bool
    {
        foreach ((array) $pattern as $p) {
            if (preg_match((string) $p, $value) !== []) { return true; }
        }
        return false;
    }

    public static function isUrl(mixed $value, array $protocols = []): bool
    {
        if (!is_string($value)) { return false; }
        $scheme = $protocols === [] ? '[a-z][a-z0-9+.\-]*' : implode('|', array_map(fn (string $p): string => preg_quote($p, '~'), $protocols));
        return preg_match('~^(' . $scheme . ')://([^\s/?#@]+@)?([\pL\pN\pS\pM\-_.]+|\[[0-9a-f:.]+\])(:[0-9]+)?([/?#][^\s]*)?$~iu', $value) !== [];
    }

    public static function trim(string $value, ?string $charlist = null): string { return $charlist === null ? preg_replace('~^[\s\x{FEFF}\x{200B}\x{200E}]+|[\s\x{FEFF}\x{200B}\x{200E}]+$~u', '', $value) : trim($value, $charlist); }
    public static function ltrim(string $value, ?string $charlist = null): string { return $charlist === null ? preg_replace('~^[\s\x{FEFF}\x{200B}\x{200E}]+~u', '', $value) : ltrim($value, $charlist); }
    public static function rtrim(string $value, ?string $charlist = null): string { return $charlist === null ? preg_replace('~[\s\x{FEFF}\x{200B}\x{200E}]+$~u', '', $value) : rtrim($value, $charlist); }

    /** The first group (or the whole match) of $pattern, '' when it does not match. */
    public static function match(string $pattern, string $subject): string
    {
        $m = preg_match($pattern, $subject);
        if ($m === false || $m === []) { return ''; }
        return (string) ($m[1] ?? $m[0]);
    }

    public static function matchAll(string $pattern, string $subject): Collection
    {
        $all = preg_match_all($pattern, $subject);
        if ($all === false || ($all[0] ?? []) === []) { return new Collection([]); }
        return new Collection($all[1] ?? $all[0]);
    }

    public static function numbers(string $value): string { return preg_replace('/[^0-9]/', '', $value); }
    public static function pascal(string $value): string { return self::studly($value); }

    public static function position(string $haystack, string $needle, int $offset = 0): int|false { return mb_strpos($haystack, $needle, $offset); }

    public static function remove(string|array $search, string $subject, bool $caseSensitive = true): string
    {
        return $caseSensitive ? str_replace($search, '', $subject) : str_ireplace($search, '', $subject);
    }

    public static function repeat(string $string, int $times): string { return str_repeat($string, $times); }

    public static function replaceArray(string $search, array $replace, string $subject): string
    {
        [$result, $segments] = \Arr::shift(explode($search, $subject));
        $values = array_values($replace);
        foreach ($segments as $i => $segment) {
            $result .= (array_key_exists($i, $values) ? (string) $values[$i] : $search) . $segment;
        }
        return $result;
    }

    public static function replaceStart(string $search, string $replace, string $subject): string
    {
        if ($search === '') { return $subject; }
        return str_starts_with($subject, $search) ? self::replaceFirst($search, $replace, $subject) : $subject;
    }

    public static function replaceEnd(string $search, string $replace, string $subject): string
    {
        if ($search === '') { return $subject; }
        return str_ends_with($subject, $search) ? self::replaceLast($search, $replace, $subject) : $subject;
    }

    public static function replaceLast(string $search, string $replace, string $subject): string
    {
        if ($search === '') { return $subject; }
        $pos = strrpos($subject, $search);
        return $pos === false ? $subject : substr_replace($subject, $replace, $pos, strlen($search));
    }

    public static function replaceMatches(string|array $pattern, string|array $replace, string $subject, int $limit = -1): string
    {
        return preg_replace($pattern, $replace, $subject, $limit);
    }

    public static function reverse(string $value): string { return implode('', array_reverse(mb_str_split($value))); }

    public static function substr(string $string, int $start, ?int $length = null): string { return mb_substr($string, $start, $length); }
    public static function substrCount(string $haystack, string $needle, int $offset = 0, ?int $length = null): int
    {
        return $length === null ? substr_count($haystack, $needle, $offset) : substr_count($haystack, $needle, $offset, $length);
    }

    public static function substrReplace(string $string, string $replace, int $offset = 0, ?int $length = null): string
    {
        return $length === null ? substr_replace($string, $replace, $offset) : substr_replace($string, $replace, $offset, $length);
    }

    public static function swap(array $map, string $subject): string { return strtr($subject, $map); }

    public static function take(string $string, int $limit): string { return $limit < 0 ? mb_substr($string, $limit) : mb_substr($string, 0, $limit); }

    public static function ucwords(string $string, string $separators = " \t\r\n\f\v"): string { return ucwords($string, $separators); }

    public static function unwrap(string $value, string $before, ?string $after = null): string
    {
        if (self::startsWith($value, $before)) { $value = mb_substr($value, mb_strlen($before)); }
        $after = $after ?? $before;
        if (self::endsWith($value, $after)) { $value = mb_substr($value, 0, -mb_strlen($after)); }
        return $value;
    }

    /** Words as str_word_count counts them: letters, apostrophes and hyphens. */
    public static function wordCount(string $string, ?string $characters = null): int
    {
        $extra = $characters === null ? '' : preg_quote($characters, '/');
        $m = preg_match_all('/[A-Za-z\'\-' . $extra . ']+/', $string);
        return $m === false ? 0 : count($m[0] ?? []);
    }

    public static function wordWrap(string $string, int $characters = 75, string $break = "\n", bool $cutLongWords = false): string
    {
        return wordwrap($string, $characters, $break, $cutLongWords);
    }

    public static function convertCase(string $string, int $mode = MB_CASE_FOLD): string { return mb_convert_case($string, $mode); }

    public static function initials(string $value, bool $capitalize = false): string
    {
        $out = '';
        foreach (preg_split('/\s+/u', $value, -1, PREG_SPLIT_NO_EMPTY) as $part) { $out .= mb_substr($part, 0, 1); }
        return $capitalize ? self::upper($out) : $out;
    }

    /** Title case in APA style: minor words of up to three letters stay lower case inside a title. */
    public static function apa(string $value): string
    {
        if (trim($value) === '') { return $value; }
        $minor = ['and', 'as', 'but', 'for', 'if', 'nor', 'or', 'so', 'yet', 'a', 'an', 'the', 'at', 'by', 'in', 'of', 'off', 'on', 'per', 'to', 'up', 'via', 'et', 'ou', 'un', 'une', 'la', 'le', 'les', 'de', 'du', 'des', 'par', 'à'];
        $endPunctuation = ['.', '!', '?', ':', '—', ','];
        $words = preg_split('/\s+/u', $value, -1, PREG_SPLIT_NO_EMPTY);
        $out = [];
        foreach ($words as $i => $word) {
            $lower = mb_strtolower($word);
            if (str_contains($lower, '-')) {
                $parts = [];
                foreach (explode('-', $lower) as $part) {
                    $parts[] = in_array($part, $minor, true) && mb_strlen($part) <= 3 ? $part : self::ucfirst($part);
                }
                $out[] = implode('-', $parts);
            } elseif (in_array($lower, $minor, true) && mb_strlen($lower) <= 3 && !($i === 0 || in_array(mb_substr($words[$i - 1], -1), $endPunctuation, true))) {
                $out[] = $lower;
            } else {
                $out[] = self::ucfirst($lower);
            }
        }
        return implode(' ', $out);
    }

    public static function plural(string $value, int|array|\Countable $count = 2): string
    {
        if (is_array($count) || $count instanceof \Countable) { $count = count($count); }
        if (abs($count) === 1 || Inflector::uncountable($value)) { return $value; }
        return Inflector::matchCase(Inflector::plural($value), $value);
    }

    public static function singular(string $value): string
    {
        if (Inflector::uncountable($value)) { return $value; }
        return Inflector::matchCase(Inflector::singular($value), $value);
    }

    /** The last word of a StudlyCase name in the plural. */
    public static function pluralStudly(string $value, int|array|\Countable $count = 2): string
    {
        [$last, $parts] = \Arr::pop(preg_split('/(.)(?=[A-Z])/u', $value, -1, PREG_SPLIT_DELIM_CAPTURE));
        return implode('', $parts) . self::plural($last, $count);
    }

    public static function pluralPascal(string $value, int|array|\Countable $count = 2): string { return self::pluralStudly($value, $count); }

    /** A fluent string (Stringable). */
    public static function of(string $string): Stringable { return new Stringable($string); }
}

/** English plural and singular forms (S1b): irregular words, uncountable words, suffix rules. */
final class Inflector
{
    private const IRREGULAR = [
        'person' => 'people', 'man' => 'men', 'woman' => 'women', 'child' => 'children', 'foot' => 'feet', 'tooth' => 'teeth',
        'goose' => 'geese', 'mouse' => 'mice', 'louse' => 'lice', 'ox' => 'oxen', 'leaf' => 'leaves', 'life' => 'lives',
        'knife' => 'knives', 'wife' => 'wives', 'half' => 'halves', 'self' => 'selves', 'elf' => 'elves', 'loaf' => 'loaves',
        'thief' => 'thieves', 'wolf' => 'wolves', 'calf' => 'calves', 'shelf' => 'shelves', 'criterion' => 'criteria',
        'phenomenon' => 'phenomena', 'datum' => 'data', 'medium' => 'media', 'curriculum' => 'curricula', 'cactus' => 'cacti',
        'focus' => 'foci', 'fungus' => 'fungi', 'nucleus' => 'nuclei', 'radius' => 'radii', 'stimulus' => 'stimuli',
        'syllabus' => 'syllabi', 'alumnus' => 'alumni', 'axis' => 'axes', 'index' => 'indices', 'matrix' => 'matrices',
        'vertex' => 'vertices', 'appendix' => 'appendices', 'quiz' => 'quizzes', 'zombie' => 'zombies', 'move' => 'moves',
        'sex' => 'sexes', 'genus' => 'genera', 'corpus' => 'corpora', 'die' => 'dice', 'echo' => 'echoes', 'hero' => 'heroes',
        'potato' => 'potatoes', 'tomato' => 'tomatoes', 'veto' => 'vetoes', 'torpedo' => 'torpedoes', 'status' => 'statuses',
        'campus' => 'campuses', 'virus' => 'viruses', 'octopus' => 'octopuses', 'bus' => 'buses', 'gas' => 'gases',
    ];

    private const UNCOUNTABLE = [
        'sheep', 'fish', 'deer', 'series', 'species', 'money', 'rice', 'information', 'equipment', 'news', 'feedback',
        'audio', 'data', 'evidence', 'furniture', 'knowledge', 'luggage', 'traffic', 'music', 'police', 'software',
        'hardware', 'homework', 'advice', 'chassis', 'moose', 'swine', 'bison', 'salmon', 'trout', 'aircraft', 'offspring',
        'jeans', 'pants', 'scissors', 'metadata', 'cattle', 'staff', 'compensation', 'education', 'emoji', 'gold',
        'love', 'nutrition', 'plankton', 'pokemon', 'progress', 'research', 'sugar', 'weather', 'wheat', 'wood', 'wool',
        'coreopsis', 'deer', 'cookie',
    ];

    public static function uncountable(string $value): bool
    {
        $word = mb_strtolower(preg_replace('/^.*?([a-z]+)$/i', '$1', $value));
        return in_array($word, self::UNCOUNTABLE, true) && $word !== 'cookie';
    }

    public static function plural(string $word): string
    {
        $lower = mb_strtolower($word);
        if (array_key_exists($lower, self::IRREGULAR)) { return self::IRREGULAR[$lower]; }
        if (in_array($lower, self::IRREGULAR, true)) { return $lower; }
        foreach ([
            ['/(quiz)$/i', '$1zes'], ['/(matr|vert|ind)(ix|ex)$/i', '$1ices'], ['/(x|ch|ss|sh|zz)$/i', '$1es'],
            ['/([^aeiouy]|qu)y$/i', '$1ies'], ['/(?:([^f])fe|([lr])f)$/i', '$1$2ves'], ['/sis$/i', 'ses'],
            ['/([ti])um$/i', '$1a'], ['/(alias|status|bus|campus)$/i', '$1es'], ['/(octop|vir)us$/i', '$1uses'],
            ['/(ax|test)is$/i', '$1es'], ['/s$/i', 's'], ['/$/', 's'],
        ] as [$pattern, $replacement]) {
            if (preg_match($pattern, $lower) !== []) { return preg_replace($pattern, $replacement, $lower, 1); }
        }
        return $lower . 's';
    }

    public static function singular(string $word): string
    {
        $lower = mb_strtolower($word);
        $flip = array_flip(self::IRREGULAR);
        if (array_key_exists($lower, $flip)) { return (string) $flip[$lower]; }
        if (array_key_exists($lower, self::IRREGULAR)) { return $lower; }
        foreach ([
            ['/(quiz)zes$/i', '$1'], ['/(matr)ices$/i', '$1ix'], ['/(vert|ind)ices$/i', '$1ex'], ['/(alias|status|bus|campus)es$/i', '$1'],
            ['/(octop|vir)uses$/i', '$1us'], ['/(cris|ax|test)es$/i', '$1is'], ['/(analy|ba|diagno|parenthe|progno|synop|the)ses$/i', '$1sis'],
            ['/([ti])a$/i', '$1um'], ['/(x|ch|ss|sh|zz)es$/i', '$1'], ['/([^aeiouy]|qu)ies$/i', '$1y'],
            ['/([lr])ves$/i', '$1f'], ['/([^f])ves$/i', '$1fe'], ['/(ss)$/i', '$1'], ['/s$/i', ''],
        ] as [$pattern, $replacement]) {
            if (preg_match($pattern, $lower) !== []) { return preg_replace($pattern, $replacement, $lower, 1); }
        }
        return $lower;
    }

    /** The case pattern of $comparison applied to $value: UPPER, Ucfirst or as is. */
    public static function matchCase(string $value, string $comparison): string
    {
        if (mb_strtoupper($comparison) === $comparison && mb_strtolower($comparison) !== $comparison) { return mb_strtoupper($value); }
        if (mb_strtoupper(mb_substr($comparison, 0, 1)) === mb_substr($comparison, 0, 1) && mb_strtolower(mb_substr($comparison, 0, 1)) !== mb_substr($comparison, 0, 1)) {
            return mb_strtoupper(mb_substr($value, 0, 1)) . mb_substr($value, 1);
        }
        return $value;
    }
}

final class Arr
{
    public static function accessible(mixed $value): bool
    {
        return is_array($value) || $value instanceof \ArrayAccess;
    }

    public static function exists(array $array, string|int $key): bool
    {
        return array_key_exists($key, $array);
    }

    /** Dot-notation read: `Arr::get($a, 'user.name', 'x')`. */
    public static function get(mixed $array, string|int|null $key, mixed $default = null): mixed
    {
        if (!self::accessible($array)) { return $default instanceof \Closure ? $default() : $default; }
        if ($key === null) { return $array; }
        if (is_array($array) && array_key_exists($key, $array)) { return $array[$key]; }
        if (!is_string($key) || !str_contains($key, '.')) {
            return is_array($array) ? ($default instanceof \Closure ? $default() : $default) : ($array[$key] ?? $default);
        }
        $current = $array;
        foreach (explode('.', $key) as $segment) {
            if (is_array($current) && array_key_exists($segment, $current)) {
                $current = $current[$segment];
            } elseif ($current instanceof \ArrayAccess && isset($current[$segment])) {
                $current = $current[$segment];
            } else {
                return $default instanceof \Closure ? $default() : $default;
            }
        }
        return $current;
    }

    public static function has(array $array, string|array $keys): bool
    {
        $keys = (array) $keys;
        if ($keys === [] || $array === []) { return false; }
        $missing = new \stdClass();
        foreach ($keys as $key) {
            if (self::get($array, $key, $missing) === $missing) { return false; }
        }
        return true;
    }

    public static function hasAny(array $array, string|array $keys): bool
    {
        foreach ((array) $keys as $key) {
            if (self::has($array, $key)) { return true; }
        }
        return false;
    }

    /** Dot-notation write; returns the new array (no references in the dialect). */
    public static function set(array $array, string|int|null $key, mixed $value): array
    {
        if ($key === null) { return (array) $value; }
        $keys = is_string($key) ? explode('.', $key) : [$key];
        return self::setPath($array, $keys, $value);
    }

    private static function setPath(array $array, array $keys, mixed $value): array
    {
        $first = $keys[0];
        if (count($keys) === 1) {
            $array[$first] = $value;
            return $array;
        }
        $inner = isset($array[$first]) && is_array($array[$first]) ? $array[$first] : [];
        $array[$first] = self::setPath($inner, array_slice($keys, 1), $value);
        return $array;
    }

    /** Removes keys (dot notation); returns the new array. */
    public static function forget(array $array, string|int|array $keys): array
    {
        foreach ((array) $keys as $key) {
            if (array_key_exists($key, $array)) {
                unset($array[$key]);
                continue;
            }
            $parts = explode('.', (string) $key);
            $array = self::forgetPath($array, $parts);
        }
        return $array;
    }

    private static function forgetPath(array $array, array $parts): array
    {
        $first = $parts[0];
        if (count($parts) === 1) {
            unset($array[$first]);
            return $array;
        }
        if (isset($array[$first]) && is_array($array[$first])) {
            $array[$first] = self::forgetPath($array[$first], array_slice($parts, 1));
        }
        return $array;
    }

    public static function add(array $array, string|int $key, mixed $value): array
    {
        if (self::get($array, $key) === null) { return self::set($array, $key, $value); }
        return $array;
    }

    public static function only(array $array, array|string $keys): array
    {
        return array_intersect_key($array, array_flip((array) $keys));
    }

    public static function except(array $array, array|string $keys): array
    {
        return self::forget($array, $keys);
    }

    public static function first(array $array, ?callable $callback = null, mixed $default = null): mixed
    {
        if ($callback === null) {
            if ($array === []) { return $default instanceof \Closure ? $default() : $default; }
            return $array[array_key_first($array)];
        }
        foreach ($array as $key => $value) {
            if ($callback($value, $key)) { return $value; }
        }
        return $default instanceof \Closure ? $default() : $default;
    }

    public static function last(array $array, ?callable $callback = null, mixed $default = null): mixed
    {
        if ($callback === null) {
            if ($array === []) { return $default instanceof \Closure ? $default() : $default; }
            return $array[array_key_last($array)];
        }
        return self::first(array_reverse($array, true), $callback, $default);
    }

    public static function wrap(mixed $value): array
    {
        if ($value === null) { return []; }
        return is_array($value) ? $value : [$value];
    }

    public static function flatten(array $array, int|float $depth = INF): array
    {
        $result = [];
        foreach ($array as $item) {
            $item = $item instanceof Collection ? $item->all() : $item;
            if (!is_array($item)) {
                $result[] = $item;
            } else {
                $values = $depth === 1 ? array_values($item) : self::flatten($item, $depth - 1);
                foreach ($values as $v) { $result[] = $v; }
            }
        }
        return $result;
    }

    public static function collapse(array $array): array
    {
        $result = [];
        foreach ($array as $values) {
            $values = $values instanceof Collection ? $values->all() : $values;
            if (!is_array($values)) { continue; }
            foreach ($values as $v) { $result[] = $v; }
        }
        return $result;
    }

    public static function pluck(array $array, string|int|null $value, string|int|null $key = null): array
    {
        $results = [];
        foreach ($array as $item) {
            $itemValue = data_get($item, $value);
            if ($key === null) {
                $results[] = $itemValue;
            } else {
                $itemKey = data_get($item, $key);
                $results[is_object($itemKey) ? (string) $itemKey : $itemKey] = $itemValue;
            }
        }
        return $results;
    }

    public static function keyBy(array $array, string|callable $keyBy): array
    {
        $results = [];
        foreach ($array as $key => $item) {
            $k = is_string($keyBy) && !is_callable($keyBy) ? data_get($item, $keyBy) : $keyBy($item, $key);
            $results[is_object($k) ? (string) $k : $k] = $item;
        }
        return $results;
    }

    public static function where(array $array, callable $callback): array
    {
        return array_filter($array, $callback, ARRAY_FILTER_USE_BOTH);
    }

    public static function whereNotNull(array $array): array
    {
        return array_filter($array, fn($v) => $v !== null);
    }

    public static function map(array $array, callable $callback): array
    {
        $keys = array_keys($array);
        $items = array_map($callback, $array, $keys);
        return array_combine($keys, $items);
    }

    public static function mapWithKeys(array $array, callable $callback): array
    {
        $result = [];
        foreach ($array as $key => $value) {
            foreach ($callback($value, $key) as $k => $v) { $result[$k] = $v; }
        }
        return $result;
    }

    public static function isAssoc(array $array): bool { return !array_is_list($array); }
    public static function isList(array $array): bool { return array_is_list($array); }

    public static function dot(array $array, string $prepend = ''): array
    {
        $results = [];
        foreach ($array as $key => $value) {
            if (is_array($value) && $value !== []) {
                foreach (self::dot($value, $prepend . $key . '.') as $k => $v) { $results[$k] = $v; }
            } else {
                $results[$prepend . $key] = $value;
            }
        }
        return $results;
    }

    public static function undot(array $array): array
    {
        $results = [];
        foreach ($array as $key => $value) { $results = self::set($results, $key, $value); }
        return $results;
    }

    public static function join(array $array, string $glue, string $finalGlue = ''): string
    {
        if ($finalGlue === '') { return implode($glue, $array); }
        if (count($array) === 0) { return ''; }
        if (count($array) === 1) { return (string) $array[array_key_first($array)]; }
        $finalItem = $array[array_key_last($array)];
        return implode($glue, array_slice($array, 0, -1)) . $finalGlue . $finalItem;
    }

    public static function prepend(array $array, mixed $value, string|int|null $key = null): array
    {
        if ($key === null) { return array_merge([$value], $array); }
        return [$key => $value] + $array;
    }

    public static function query(array $array): string { return http_build_query($array, '', '&', PHP_QUERY_RFC3986); }

    public static function random(array $array): mixed { return $array[array_rand($array)]; }

    // replacements for the by-reference array functions: [value, rest]
    public static function pop(array $a): array { return \Arr::pop($a); }
    public static function shift(array $a): array { return \Arr::shift($a); }

    // ---- S1b ---------------------------------------------------------------

    public static function arrayable(mixed $value): bool
    {
        return is_array($value) || $value instanceof \Traversable || $value instanceof \JsonSerializable || $value instanceof Collection;
    }

    /** Typed reads: the value at $key must have the type, else InvalidArgumentException. */
    public static function array(array|\ArrayAccess $array, string|int|null $key, ?array $default = null): array
    {
        $value = self::get($array, $key, $default);
        if (!is_array($value)) { throw self::typeMismatch($key, 'an array', $value); }
        return $value;
    }

    public static function boolean(array|\ArrayAccess $array, string|int|null $key, ?bool $default = null): bool
    {
        $value = self::get($array, $key, $default);
        if (!is_bool($value)) { throw self::typeMismatch($key, 'a boolean', $value); }
        return $value;
    }

    public static function float(array|\ArrayAccess $array, string|int|null $key, ?float $default = null): float
    {
        $value = self::get($array, $key, $default);
        if (!is_float($value)) { throw self::typeMismatch($key, 'a float', $value); }
        return $value;
    }

    public static function integer(array|\ArrayAccess $array, string|int|null $key, ?int $default = null): int
    {
        $value = self::get($array, $key, $default);
        if (!is_int($value)) { throw self::typeMismatch($key, 'an integer', $value); }
        return $value;
    }

    public static function string(array|\ArrayAccess $array, string|int|null $key, ?string $default = null): string
    {
        $value = self::get($array, $key, $default);
        if (!is_string($value)) { throw self::typeMismatch($key, 'a string', $value); }
        return $value;
    }

    private static function typeMismatch(string|int|null $key, string $what, mixed $value): \InvalidArgumentException
    {
        return new \InvalidArgumentException(sprintf('Array value for key [%s] must be %s, %s found.', (string) $key, $what, gettype($value)));
    }

    public static function from(mixed $items): array
    {
        if (is_array($items)) { return $items; }
        if ($items instanceof Collection) { return $items->all(); }
        if ($items instanceof \Traversable) { return iterator_to_array($items); }
        if ($items instanceof \JsonSerializable) { return (array) $items->jsonSerialize(); }
        if (is_object($items)) { return (array) $items; }
        throw new \InvalidArgumentException('Items cannot be represented by a scalar value.');
    }

    public static function divide(array $array): array { return [array_keys($array), array_values($array)]; }

    public static function crossJoin(array ...$arrays): array
    {
        $results = [[]];
        foreach ($arrays as $index => $list) {
            $append = [];
            foreach ($results as $product) {
                foreach ($list as $item) {
                    $product[$index] = $item;
                    $append[] = $product;
                }
            }
            $results = $append;
        }
        return $results;
    }

    public static function every(iterable $array, callable $callback): bool
    {
        foreach ($array as $key => $value) {
            if (!$callback($value, $key)) { return false; }
        }
        return true;
    }

    public static function some(iterable $array, callable $callback): bool
    {
        foreach ($array as $key => $value) {
            if ($callback($value, $key)) { return true; }
        }
        return false;
    }

    public static function exceptValues(array $array, mixed $values, bool $strict = false): array
    {
        $values = (array) $values;
        return array_filter($array, fn (mixed $v): bool => !in_array($v, $values, $strict));
    }

    public static function onlyValues(array $array, mixed $values, bool $strict = false): array
    {
        $values = (array) $values;
        return array_filter($array, fn (mixed $v): bool => in_array($v, $values, $strict));
    }

    public static function hasAll(array $array, string|array $keys): bool
    {
        $keys = (array) $keys;
        if ($array === [] || $keys === []) { return false; }
        foreach ($keys as $key) {
            if (!self::has($array, $key)) { return false; }
        }
        return true;
    }

    public static function mapSpread(array $array, callable $callback): array
    {
        return self::map($array, function (mixed $chunk, string|int $key) use ($callback): mixed {
            $chunk[] = $key;
            return $callback(...array_values($chunk));
        });
    }

    public static function partition(iterable $array, callable $callback): array
    {
        $passed = [];
        $failed = [];
        foreach ($array as $key => $item) {
            if ($callback($item, $key)) { $passed[$key] = $item; } else { $failed[$key] = $item; }
        }
        return [$passed, $failed];
    }

    public static function prependKeysWith(array $array, string $prependWith): array
    {
        return self::mapWithKeys($array, fn (mixed $item, string|int $key): array => [$prependWith . $key => $item]);
    }

    /** Appends to the list at $key; returns the new root array (no references in the dialect). */
    public static function push(array $array, string|int|null $key, mixed ...$values): array
    {
        $target = self::array($array, $key, []);
        foreach ($values as $v) { $target[] = $v; }
        return self::set($array, $key, $target);
    }

    /** Like Arr::pop/shift: returns [value, rest]. */
    public static function pull(array $array, string|int $key, mixed $default = null): array
    {
        return [self::get($array, $key, $default), self::forget($array, $key)];
    }

    public static function reject(array $array, callable $callback): array
    {
        return self::where($array, fn (mixed $value, string|int $key): bool => !$callback($value, $key));
    }

    public static function select(array $array, mixed $keys): array { return (new Collection($array))->select(self::wrap($keys))->all(); }

    public static function shuffle(array $array): array { return shuffle($array); }

    public static function sole(array $array, ?callable $callback = null): mixed
    {
        if ($callback !== null) { $array = self::where($array, $callback); }
        $count = count($array);
        if ($count === 0) { throw new ItemNotFoundException(); }
        if ($count > 1) { throw new MultipleItemsFoundException($count); }
        return self::first($array);
    }

    public static function sort(array $array, string|callable|null $callback = null): array { return (new Collection($array))->sortBy($callback)->all(); }
    public static function sortDesc(array $array, string|callable|null $callback = null): array { return (new Collection($array))->sortByDesc($callback)->all(); }

    public static function sortRecursive(array $array, int $options = SORT_REGULAR, bool $descending = false): array
    {
        $out = [];
        foreach ($array as $k => $v) { $out[$k] = is_array($v) ? self::sortRecursive($v, $options, $descending) : $v; }
        if (!array_is_list($out)) { return $descending ? krsort($out, $options) : ksort($out, $options); }
        return $descending ? rsort($out, $options) : sort($out, $options);
    }

    public static function sortRecursiveDesc(array $array, int $options = SORT_REGULAR): array { return self::sortRecursive($array, $options, true); }

    public static function take(array $array, int $limit): array
    {
        return $limit < 0 ? array_slice($array, $limit, abs($limit)) : array_slice($array, 0, $limit);
    }

    public static function toCssClasses(mixed $array): string
    {
        $classes = [];
        foreach (self::wrap($array) as $class => $constraint) {
            if (is_int($class)) { $classes[] = $constraint; } elseif ($constraint) { $classes[] = $class; }
        }
        return implode(' ', $classes);
    }

    public static function toCssStyles(mixed $array): string
    {
        $styles = [];
        foreach (self::wrap($array) as $style => $constraint) {
            if (is_int($style)) { $styles[] = Str::finish($constraint, ';'); } elseif ($constraint) { $styles[] = Str::finish($style, ';'); }
        }
        return implode(' ', $styles);
    }
}

/** A collection of items (Laravel's Illuminate\Support\Collection, core methods). */
class Collection implements \ArrayAccess, \Countable, \IteratorAggregate, \JsonSerializable
{
    protected array $items;

    public function __construct(mixed $items = [])
    {
        $this->items = self::arrayOf($items);
    }

    protected static function arrayOf(mixed $items): array
    {
        if (is_array($items)) { return $items; }
        if ($items instanceof Collection) { return $items->all(); }
        if ($items === null) { return []; }
        if ($items instanceof \Traversable) { return iterator_to_array($items); }
        return [$items];
    }

    public static function make(mixed $items = []): static { return new static($items); }

    /** `callable` or a key for data_get. */
    protected function valueRetriever(mixed $value): \Closure
    {
        if ($value instanceof \Closure) { return $value; }
        if ($value === null) { return fn($item) => $item; }
        return fn($item) => data_get($item, $value);
    }

    public function all(): array { return $this->items; }
    public function count(): int { return count($this->items); }
    public function isEmpty(): bool { return $this->items === []; }
    public function isNotEmpty(): bool { return $this->items !== []; }
    public function keys(): static { return new static(array_keys($this->items)); }
    public function values(): static { return new static(array_values($this->items)); }

    public function toArray(): array
    {
        $out = [];
        foreach ($this->items as $k => $v) {
            $out[$k] = is_object($v) && method_exists($v, 'toArray') ? $v->toArray() : $v;
        }
        return $out;
    }

    public function jsonSerialize(): mixed
    {
        $out = [];
        foreach ($this->items as $k => $v) {
            if ($v instanceof \JsonSerializable) {
                $out[$k] = $v->jsonSerialize();
            } elseif (is_object($v) && method_exists($v, 'toArray')) {
                $out[$k] = $v->toArray();
            } else {
                $out[$k] = $v;
            }
        }
        return $out;
    }

    public function toJson(int $options = 0): string { return json_encode($this->jsonSerialize(), $options); }

    public function get(string|int $key, mixed $default = null): mixed
    {
        if (array_key_exists($key, $this->items)) { return $this->items[$key]; }
        return $default instanceof \Closure ? $default() : $default;
    }

    public function has(string|int|array $key): bool
    {
        foreach ((array) $key as $k) {
            if (!array_key_exists($k, $this->items)) { return false; }
        }
        return true;
    }

    public function first(?callable $callback = null, mixed $default = null): mixed { return Arr::first($this->items, $callback, $default); }
    public function last(?callable $callback = null, mixed $default = null): mixed { return Arr::last($this->items, $callback, $default); }

    public function map(callable $callback): static { return new static(Arr::map($this->items, $callback)); }
    public function mapWithKeys(callable $callback): static { return new static(Arr::mapWithKeys($this->items, $callback)); }

    public function each(callable $callback): static
    {
        foreach ($this->items as $key => $item) {
            if ($callback($item, $key) === false) { break; }
        }
        return $this;
    }

    public function filter(?callable $callback = null): static
    {
        if ($callback === null) { return new static(array_filter($this->items)); }
        return new static(array_filter($this->items, $callback, ARRAY_FILTER_USE_BOTH));
    }

    public function reject(callable $callback): static
    {
        return $this->filter(fn($value, $key) => !$callback($value, $key));
    }

    protected function operatorFor(string $operator, mixed $value): \Closure
    {
        return function ($item) use ($operator, $value) {
            // ordered comparison with null as in PHP: compare as booleans
            $cmp = ($item === null || $value === null) ? ((int) (bool) $item <=> (int) (bool) $value) : ($item <=> $value);
            return match ($operator) {
                '=', '==', '===' => $item === $value,
                '!=', '<>', '!==' => $item !== $value,
                '<' => $cmp < 0,
                '>' => $cmp > 0,
                '<=' => $cmp <= 0,
                '>=' => $cmp >= 0,
                default => $item === $value,
            };
        };
    }

    /** `where('done', true)`, `where('n', '>', 3)` (comparisons are strict, DIALECT §5.1). */
    public function where(string $key, mixed $operator = null, mixed $value = null): static
    {
        if (func_num_args() === 2) {
            $value = $operator;
            $operator = '=';
        }
        $test = $this->operatorFor((string) $operator, $value);
        return $this->filter(fn($item) => $test(data_get($item, $key)));
    }

    public function firstWhere(string $key, mixed $operator = null, mixed $value = null): mixed
    {
        if (func_num_args() === 2) {
            $value = $operator;
            $operator = '=';
        }
        return $this->where($key, $operator, $value)->first();
    }

    public function whereIn(string $key, array $values): static
    {
        return $this->filter(fn($item) => in_array(data_get($item, $key), $values, true));
    }

    public function whereNotNull(?string $key = null): static
    {
        return $this->filter(fn($item) => data_get($item, $key) !== null);
    }

    public function pluck(string|int $value, string|int|null $key = null): static { return new static(Arr::pluck($this->items, $value, $key)); }

    public function keyBy(string|callable $keyBy): static { return new static(Arr::keyBy($this->items, $keyBy)); }

    public function groupBy(string|callable $groupBy): static
    {
        $retrieve = $this->valueRetriever($groupBy);
        $groups = [];
        foreach ($this->items as $key => $item) {
            $g = $retrieve($item, $key);
            $g = is_bool($g) ? (int) $g : (is_object($g) ? (string) $g : $g);
            $groups[$g][] = $item;
        }
        $out = [];
        foreach ($groups as $g => $list) { $out[$g] = new static($list); }
        return new static($out);
    }

    public function sortBy(string|callable|null $callback = null, bool $descending = false): static
    {
        $retrieve = $this->valueRetriever($callback);
        $keys = [];
        foreach ($this->items as $key => $item) { $keys[$key] = $retrieve($item, $key); }
        $keys = $descending ? arsort($keys) : asort($keys);
        $out = [];
        foreach ($keys as $key => $_) { $out[$key] = $this->items[$key]; }
        return new static($out);
    }

    public function sortByDesc(string|callable|null $callback = null): static { return $this->sortBy($callback, true); }

    public function sort(?callable $callback = null): static
    {
        return new static($callback === null ? asort($this->items) : uasort($this->items, $callback));
    }

    public function sortDesc(): static { return new static(arsort($this->items)); }
    public function sortKeys(bool $descending = false): static { return new static($descending ? krsort($this->items) : ksort($this->items)); }
    public function reverse(): static { return new static(array_reverse($this->items, true)); }

    public function sum(string|callable|null $callback = null): int|float
    {
        $retrieve = $this->valueRetriever($callback);
        // int + float may turn the sum into a float: array_sum adds like PHP
        return array_sum(array_map($retrieve, array_values($this->items)));
    }

    public function avg(string|callable|null $callback = null): int|float|null
    {
        $retrieve = $this->valueRetriever($callback);
        $values = [];
        foreach ($this->items as $item) {
            $v = $retrieve($item);
            if ($v !== null) { $values[] = $v; }
        }
        if ($values === []) { return null; }
        return array_sum($values) / count($values);
    }

    public function average(string|callable|null $callback = null): int|float|null { return $this->avg($callback); }

    public function min(string|callable|null $callback = null): mixed
    {
        $retrieve = $this->valueRetriever($callback);
        $result = null;
        foreach ($this->items as $item) {
            $v = $retrieve($item);
            if ($v !== null && ($result === null || $v < $result)) { $result = $v; }
        }
        return $result;
    }

    public function max(string|callable|null $callback = null): mixed
    {
        $retrieve = $this->valueRetriever($callback);
        $result = null;
        foreach ($this->items as $item) {
            $v = $retrieve($item);
            if ($v !== null && ($result === null || $v > $result)) { $result = $v; }
        }
        return $result;
    }

    public function contains(mixed $key, mixed $operator = null, mixed $value = null): bool
    {
        if (func_num_args() === 1) {
            if ($key instanceof \Closure) {
                foreach ($this->items as $k => $item) {
                    if ($key($item, $k)) { return true; }
                }
                return false;
            }
            return in_array($key, $this->items, true);
        }
        if (func_num_args() === 2) {
            $value = $operator;
            $operator = '=';
        }
        return $this->where((string) $key, $operator, $value)->isNotEmpty();
    }

    public function unique(string|callable|null $key = null, bool $strict = false): static
    {
        $retrieve = $this->valueRetriever($key);
        $seen = [];
        $out = [];
        foreach ($this->items as $k => $item) {
            $id = $retrieve($item, $k);
            $marker = is_array($id) || is_object($id) ? serialize($id) : var_export($id, true);
            if (!array_key_exists($marker, $seen)) {
                $seen[$marker] = true;
                $out[$k] = $item;
            }
        }
        return new static($out);
    }

    public function take(int $limit): static
    {
        if ($limit < 0) { return $this->slice($limit, -$limit); }
        return $this->slice(0, $limit);
    }

    public function skip(int $count): static { return $this->slice($count); }

    public function slice(int $offset, ?int $length = null): static { return new static(array_slice($this->items, $offset, $length, true)); }

    public function chunk(int $size): static
    {
        if ($size <= 0) { return new static(); }
        $chunks = [];
        foreach (array_chunk($this->items, $size, true) as $chunk) { $chunks[] = new static($chunk); }
        return new static($chunks);
    }

    public function flatten(int|float $depth = INF): static { return new static(Arr::flatten($this->items, $depth)); }
    public function collapse(): static { return new static(Arr::collapse($this->items)); }

    public function merge(mixed $items): static { return new static(array_merge($this->items, self::arrayOf($items))); }

    public function push(mixed ...$values): static
    {
        foreach ($values as $v) { $this->items[] = $v; }
        return $this;
    }

    public function put(string|int $key, mixed $value): static
    {
        $this->items[$key] = $value;
        return $this;
    }

    public function prepend(mixed $value, string|int|null $key = null): static
    {
        $this->items = Arr::prepend($this->items, $value, $key);
        return $this;
    }

    public function pop(): mixed
    {
        [$value, $rest] = \Arr::pop($this->items);
        $this->items = $rest;
        return $value;
    }

    public function shift(): mixed
    {
        [$value, $rest] = \Arr::shift($this->items);
        $this->items = $rest;
        return $value;
    }

    public function implode(string|callable $value, ?string $glue = null): string
    {
        if ($value instanceof \Closure) { return implode($glue ?? '', $this->map($value)->all()); }
        $first = $this->first();
        if (is_array($first) || (is_object($first) && !$first instanceof \Stringable)) {
            return implode($glue ?? '', $this->pluck($value)->all());
        }
        return implode($value, $this->items);
    }

    public function join(string $glue, string $finalGlue = ''): string { return Arr::join($this->items, $glue, $finalGlue); }

    public function reduce(callable $callback, mixed $initial = null): mixed
    {
        $result = $initial;
        foreach ($this->items as $key => $item) { $result = $callback($result, $item, $key); }
        return $result;
    }

    public function only(array|string $keys): static { return new static(Arr::only($this->items, $keys)); }
    public function except(array|string $keys): static { return new static(Arr::except($this->items, $keys)); }
    public function flip(): static { return new static(array_flip($this->items)); }

    public function search(mixed $value): int|string|false
    {
        if ($value instanceof \Closure) {
            foreach ($this->items as $k => $item) {
                if ($value($item, $k)) { return $k; }
            }
            return false;
        }
        return array_search($value, $this->items, true);
    }

    public function every(callable $callback): bool
    {
        foreach ($this->items as $k => $item) {
            if (!$callback($item, $k)) { return false; }
        }
        return true;
    }

    public function partition(callable $callback): static
    {
        $pass = [];
        $fail = [];
        foreach ($this->items as $k => $item) {
            if ($callback($item, $k)) { $pass[$k] = $item; } else { $fail[$k] = $item; }
        }
        return new static([new static($pass), new static($fail)]);
    }

    public function countBy(string|callable|null $callback = null): static
    {
        $retrieve = $this->valueRetriever($callback);
        $counts = [];
        foreach ($this->items as $k => $item) {
            $g = $retrieve($item, $k);
            $counts[$g] = ($counts[$g] ?? 0) + 1;
        }
        return new static($counts);
    }

    public function pipe(callable $callback): mixed { return $callback($this); }

    public function tap(callable $callback): static
    {
        $callback($this);
        return $this;
    }

    public function when(mixed $value, callable $callback, ?callable $default = null): static
    {
        if ($value) { return $callback($this, $value) ?? $this; }
        if ($default !== null) { return $default($this, $value) ?? $this; }
        return $this;
    }

    public function unless(mixed $value, callable $callback, ?callable $default = null): static
    {
        return $this->when(!$value, $callback, $default);
    }

    // ---- S1b ---------------------------------------------------------------

    public function add(mixed $item): static { $this->items[] = $item; return $this; }

    /** The key of the first item that equals $value (or passes the callback), or null. */
    protected function keyOf(mixed $value, bool $strict): string|int|null
    {
        foreach ($this->items as $k => $item) {
            if ($value instanceof \Closure ? $value($item, $k) : $item === $value) { return $k; }
        }
        return null;
    }

    public function after(mixed $value, bool $strict = false): mixed
    {
        $key = $this->keyOf($value, $strict);
        if ($key === null) { return null; }
        $keys = array_keys($this->items);
        $pos = array_search($key, $keys, true);
        return $pos === false || $pos + 1 >= count($keys) ? null : $this->items[$keys[$pos + 1]];
    }

    public function before(mixed $value, bool $strict = false): mixed
    {
        $key = $this->keyOf($value, $strict);
        if ($key === null) { return null; }
        $keys = array_keys($this->items);
        $pos = array_search($key, $keys, true);
        return $pos === false || $pos === 0 ? null : $this->items[$keys[$pos - 1]];
    }

    public function chunkWhile(callable $callback): static
    {
        $chunks = [];
        $current = null;
        foreach ($this->items as $k => $v) {
            if ($current !== null && !$callback($v, $k, $current)) {
                $chunks[] = $current;
                $current = null;
            }
            $current = $current === null ? new static([$k => $v]) : $current->put($k, $v);
        }
        if ($current !== null) { $chunks[] = $current; }
        return new static($chunks);
    }

    public function collapseWithKeys(): static
    {
        $out = [];
        foreach ($this->items as $item) { $out = array_replace($out, self::arrayOf($item)); }
        return new static($out);
    }

    public function combine(mixed $values): static { return new static(array_combine($this->items, self::arrayOf($values))); }

    public function concat(iterable $source): static
    {
        $out = new static($this->items);
        foreach ($source as $item) { $out = $out->push($item); }
        return $out;
    }

    public function containsOneItem(?callable $callback = null): bool { return ($callback === null ? $this->count() : $this->filter($callback)->count()) === 1; }
    public function containsManyItems(?callable $callback = null): bool { return ($callback === null ? $this->count() : $this->filter($callback)->count()) > 1; }
    public function hasSole(?callable $callback = null): bool { return $this->containsOneItem($callback); }
    public function hasMany(?callable $callback = null): bool { return $this->containsManyItems($callback); }

    public function containsStrict(mixed $key, mixed $value = null): bool
    {
        if (func_num_args() === 2) { return $this->contains(fn (mixed $item): bool => data_get($item, $key) === $value); }
        if ($key instanceof \Closure) { return $this->first($key) !== null; }
        return in_array($key, $this->items, true);
    }

    public function doesntContain(mixed $key, mixed $operator = null, mixed $value = null): bool { return !$this->contains(...array_slice([$key, $operator, $value], 0, func_num_args())); }
    public function some(mixed $key, mixed $operator = null, mixed $value = null): bool { return $this->contains(...array_slice([$key, $operator, $value], 0, func_num_args())); }

    public function crossJoin(mixed ...$lists): static
    {
        $results = [[]];
        foreach (array_merge([$this->items], array_map(fn (mixed $l): array => self::arrayOf($l), $lists)) as $list) {
            $next = [];
            foreach ($results as $product) {
                foreach ($list as $item) { $next[] = array_merge($product, [$item]); }
            }
            $results = $next;
        }
        return new static($results);
    }

    public function diff(mixed $items): static { return new static(array_diff($this->items, self::arrayOf($items))); }
    public function diffAssoc(mixed $items): static { return new static(array_diff_assoc($this->items, self::arrayOf($items))); }
    public function diffKeys(mixed $items): static { return new static(array_diff_key($this->items, self::arrayOf($items))); }
    public function intersect(mixed $items): static { return new static(array_intersect($this->items, self::arrayOf($items))); }
    public function intersectAssoc(mixed $items): static { return new static(array_intersect_assoc($this->items, self::arrayOf($items))); }
    public function intersectByKeys(mixed $items): static { return new static(array_intersect_key($this->items, self::arrayOf($items))); }

    public function dot(): static { return new static(Arr::dot($this->items)); }
    public function undot(): static { return new static(Arr::undot($this->items)); }

    public function duplicates(string|callable|null $callback = null, bool $strict = false): static
    {
        $values = $callback === null ? $this->items : $this->map($this->valueRetriever($callback))->all();
        $seen = [];
        $out = [];
        foreach ($values as $k => $v) {
            $found = false;
            foreach ($seen as $s) {
                if ($s === $v) { $found = true; break; }
            }
            if ($found) { $out[$k] = $v; } else { $seen[] = $v; }
        }
        return new static($out);
    }

    public function duplicatesStrict(string|callable|null $callback = null): static { return $this->duplicates($callback, true); }

    public function eachSpread(callable $callback): static
    {
        foreach ($this->items as $k => $chunk) {
            $args = self::arrayOf($chunk);
            $args[] = $k;
            if ($callback(...array_values($args)) === false) { break; }
        }
        return $this;
    }

    public function mapSpread(callable $callback): static
    {
        $out = [];
        foreach ($this->items as $k => $chunk) {
            $args = self::arrayOf($chunk);
            $args[] = $k;
            $out[$k] = $callback(...array_values($args));
        }
        return new static($out);
    }

    public function mapToDictionary(callable $callback): static
    {
        $out = [];
        foreach ($this->items as $k => $item) {
            foreach ($callback($item, $k) as $key => $value) {
                $group = $out[$key] ?? [];
                $group[] = $value;
                $out[$key] = $group;
            }
        }
        return new static($out);
    }

    public function mapToGroups(callable $callback): static { return $this->mapToDictionary($callback)->map(fn (array $g): static => new static($g)); }

    public function flatMap(callable $callback): static { return $this->map($callback)->collapse(); }

    public function firstOrFail(?callable $callback = null): mixed
    {
        foreach ($this->items as $k => $item) {
            if ($callback === null || $callback($item, $k)) { return $item; }
        }
        throw new ItemNotFoundException();
    }

    public function sole(mixed $key = null, mixed $operator = null, mixed $value = null): mixed
    {
        $items = $key === null ? $this : ($key instanceof \Closure ? $this->filter($key) : $this->where($key, $operator, $value));
        $count = $items->count();
        if ($count === 0) { throw new ItemNotFoundException(); }
        if ($count > 1) { throw new MultipleItemsFoundException($count); }
        return $items->first();
    }

    public function forPage(int $page, int $perPage): static { return $this->slice(max(0, ($page - 1) * $perPage), $perPage); }

    public function hasAny(mixed $key): bool
    {
        foreach ((array) $key as $k) {
            if (array_key_exists($k, $this->items)) { return true; }
        }
        return false;
    }

    public function median(string|array|null $key = null): float|int|null
    {
        $values = ($key === null ? $this : $this->pluck($key))->filter(fn (mixed $v): bool => $v !== null)->sort()->values();
        $count = $values->count();
        if ($count === 0) { return null; }
        $middle = intdiv($count, 2);
        if ($count % 2 === 1) { return $values->get($middle); }
        return (new static([$values->get($middle - 1), $values->get($middle)]))->avg();
    }

    public function mode(string|array|null $key = null): ?array
    {
        if ($this->count() === 0) { return null; }
        $counts = [];
        foreach (($key === null ? $this : $this->pluck($key))->all() as $v) { $counts[$v] = ($counts[$v] ?? 0) + 1; }
        $highest = max($counts);
        $out = [];
        foreach ($counts as $v => $n) {
            if ($n === $highest) { $out[] = $v; }
        }
        return (new static($out))->sort()->values()->all();
    }

    public function mergeRecursive(mixed $items): static { return new static(array_merge_recursive($this->items, self::arrayOf($items))); }

    public function multiply(int $multiplier): static
    {
        $out = [];
        for ($i = 0; $i < $multiplier; $i++) {
            foreach ($this->items as $item) { $out[] = $item; }
        }
        return new static($out);
    }

    public function nth(int $step, int $offset = 0): static
    {
        $out = [];
        $position = 0;
        foreach (array_slice($this->items, $offset) as $item) {
            if ($position % $step === 0) { $out[] = $item; }
            $position++;
        }
        return new static($out);
    }

    public function pad(int $size, mixed $value): static { return new static(array_pad($this->items, $size, $value)); }

    public function percentage(callable $callback, int $precision = 2): ?float
    {
        if ($this->count() === 0) { return null; }
        return round($this->filter($callback)->count() / $this->count() * 100, $precision);
    }

    public function pipeThrough(array $callbacks): mixed
    {
        return array_reduce($callbacks, fn (mixed $carry, callable $callback): mixed => $callback($carry), $this);
    }

    public function reduceWithKeys(callable $callback, mixed $initial = null): mixed
    {
        $carry = $initial;
        foreach ($this->items as $k => $v) { $carry = $callback($carry, $v, $k); }
        return $carry;
    }

    public function reduceSpread(callable $callback, mixed ...$initial): array
    {
        $carry = $initial;
        foreach ($this->items as $k => $v) {
            $result = $callback(...array_merge($carry, [$v, $k]));
            if (!is_array($result)) {
                throw new \UnexpectedValueException(sprintf("%s::reduceSpread expects reducer to return an array, but got a '%s' instead.", static::class, get_debug_type($result)));
            }
            $carry = $result;
        }
        return $carry;
    }

    public function replace(mixed $items): static { return new static(array_replace($this->items, self::arrayOf($items))); }
    public function replaceRecursive(mixed $items): static { return new static(self::replaceDeep($this->items, self::arrayOf($items))); }

    protected static function replaceDeep(array $base, array $with): array
    {
        foreach ($with as $k => $v) {
            $base[$k] = is_array($v) && is_array($base[$k] ?? null) ? self::replaceDeep($base[$k], $v) : $v;
        }
        return $base;
    }

    public function select(mixed $keys): static
    {
        $keys = is_array($keys) ? $keys : func_get_args();
        return $this->map(function (mixed $item) use ($keys): array {
            $out = [];
            foreach ($keys as $k) {
                if (is_array($item) ? array_key_exists($k, $item) : (is_object($item) && isset($item->$k))) { $out[$k] = data_get($item, $k); }
            }
            return $out;
        });
    }

    protected function predicate(mixed $value): \Closure
    {
        return $value instanceof \Closure ? $value : fn (mixed $item): bool => $item === $value;
    }

    public function skipUntil(mixed $value): static
    {
        $test = $this->predicate($value);
        $out = [];
        $taking = false;
        foreach ($this->items as $k => $item) {
            if (!$taking && $test($item, $k)) { $taking = true; }
            if ($taking) { $out[$k] = $item; }
        }
        return new static($out);
    }

    public function skipWhile(mixed $value): static
    {
        $test = $this->predicate($value);
        return $this->skipUntil(fn (mixed $item, string|int $k): bool => !$test($item, $k));
    }

    public function takeUntil(mixed $value): static
    {
        $test = $this->predicate($value);
        $out = [];
        foreach ($this->items as $k => $item) {
            if ($test($item, $k)) { break; }
            $out[$k] = $item;
        }
        return new static($out);
    }

    public function takeWhile(mixed $value): static
    {
        $test = $this->predicate($value);
        return $this->takeUntil(fn (mixed $item, string|int $k): bool => !$test($item, $k));
    }

    public function sliding(int $size = 2, int $step = 1): static
    {
        $chunks = (int) floor(($this->count() - $size) / $step) + 1;
        $out = [];
        for ($i = 0; $i < $chunks; $i++) { $out[] = $this->slice($i * $step, $size); }
        return new static($out);
    }

    public function sortKeysDesc(): static { return $this->sortKeys(true); }
    public function sortKeysUsing(callable $callback): static { return new static(uksort($this->items, $callback)); }

    public function split(int $numberOfGroups): static
    {
        if ($this->isEmpty()) { return new static([]); }
        $groupSize = intdiv($this->count(), $numberOfGroups);
        $remain = $this->count() % $numberOfGroups;
        $start = 0;
        $groups = [];
        $values = array_values($this->items);
        for ($i = 0; $i < $numberOfGroups; $i++) {
            $size = $groupSize + ($i < $remain ? 1 : 0);
            if ($size > 0) { $groups[] = new static(array_slice($values, $start, $size)); }
            $start += $size;
        }
        return new static($groups);
    }

    public function splitIn(int $numberOfGroups): static { return $this->chunk((int) ceil($this->count() / $numberOfGroups)); }

    public function union(mixed $items): static { return new static($this->items + self::arrayOf($items)); }
    public function uniqueStrict(string|callable|null $key = null): static { return $this->unique($key, true); }

    public function value(string $key, mixed $default = null): mixed
    {
        $first = $this->first(fn (mixed $item): bool => data_get($item, $key) !== null);
        return $first === null ? ($default instanceof \Closure ? $default() : $default) : data_get($first, $key);
    }

    public function whenEmpty(callable $callback, ?callable $default = null): mixed { return $this->when($this->isEmpty(), $callback, $default); }
    public function whenNotEmpty(callable $callback, ?callable $default = null): mixed { return $this->when($this->isNotEmpty(), $callback, $default); }
    public function unlessEmpty(callable $callback, ?callable $default = null): mixed { return $this->whenNotEmpty($callback, $default); }
    public function unlessNotEmpty(callable $callback, ?callable $default = null): mixed { return $this->whenEmpty($callback, $default); }

    public function whereBetween(string $key, array $values): static
    {
        return $this->filter(fn (mixed $item): bool => data_get($item, $key) >= reset_value($values) && data_get($item, $key) <= end_value($values));
    }

    public function whereNotBetween(string $key, array $values): static
    {
        return $this->filter(fn (mixed $item): bool => data_get($item, $key) < reset_value($values) || data_get($item, $key) > end_value($values));
    }

    public function whereNotIn(string $key, array $values): static { return $this->reject(fn (mixed $item): bool => in_array(data_get($item, $key), $values, true)); }
    public function whereNull(?string $key = null): static { return $this->filter(fn (mixed $item): bool => ($key === null ? $item : data_get($item, $key)) === null); }
    public function whereStrict(string $key, mixed $value): static { return $this->filter(fn (mixed $item): bool => data_get($item, $key) === $value); }
    public function whereInStrict(string $key, array $values): static { return $this->filter(fn (mixed $item): bool => in_array(data_get($item, $key), $values, true)); }
    public function whereNotInStrict(string $key, array $values): static { return $this->reject(fn (mixed $item): bool => in_array(data_get($item, $key), $values, true)); }

    public function zip(mixed ...$items): static
    {
        $arrays = array_map(fn (mixed $i): array => array_values(self::arrayOf($i)), $items);
        $out = [];
        foreach (array_values($this->items) as $i => $item) {
            $row = [$item];
            foreach ($arrays as $a) { $row[] = $a[$i] ?? null; }
            $out[] = new static($row);
        }
        return new static($out);
    }

    public function unshift(mixed ...$values): static { $this->items = array_merge($values, $this->items); return $this; }
    public function toPrettyJson(int $options = 0): string { return json_encode($this->jsonSerialize(), JSON_PRETTY_PRINT | $options); }

    /** Removes and returns a slice; the collection keeps the rest (and the replacement). */
    public function splice(int $offset, ?int $length = null, mixed $replacement = []): static
    {
        $values = array_values($this->items);
        $count = count($values);
        $start = $offset < 0 ? max(0, $count + $offset) : min($offset, $count);
        $len = $length === null ? $count - $start : ($length < 0 ? max(0, $count + $length - $start) : $length);
        $removed = array_slice($values, $start, $len);
        $this->items = array_merge(array_slice($values, 0, $start), self::arrayOf($replacement), array_slice($values, $start + $len));
        return new static($removed);
    }

    public function pull(string|int $key, mixed $default = null): mixed
    {
        $value = $this->get($key, $default);
        unset($this->items[$key]);
        return $value;
    }

    public function transform(callable $callback): static { $this->items = $this->map($callback)->all(); return $this; }

    public function forget(mixed $keys): static
    {
        foreach ((array) $keys as $k) { unset($this->items[$k]); }
        return $this;
    }

    public function getOrPut(string|int $key, mixed $value): mixed
    {
        if (array_key_exists($key, $this->items)) { return $this->items[$key]; }
        $v = $value instanceof \Closure ? $value() : $value;
        $this->items[$key] = $v;
        return $v;
    }

    public function getIterator(): \Iterator { return new \ArrayIterator($this->items); }

    public function offsetExists(mixed $key): bool { return isset($this->items[$key]); }
    public function offsetGet(mixed $key): mixed { return $this->items[$key]; }

    public function offsetSet(mixed $key, mixed $value): void
    {
        if ($key === null) { $this->items[] = $value; } else { $this->items[$key] = $value; }
    }

    public function offsetUnset(mixed $key): void { unset($this->items[$key]); }
}

/**
 * Fluent strings (S1b, Laravel's Stringable): each step returns a new
 * Stringable, questions return their answer. Built on Str.
 */
/**
 * Lazy sequence over a generator (Laravel's LazyCollection): every method
 * returns a new LazyCollection whose source is a closure producing a fresh
 * generator, so nothing runs until the values are iterated.
 */
class LazyCollection implements \IteratorAggregate, \JsonSerializable
{
    protected \Closure $source;

    public function __construct(mixed $source = null)
    {
        if ($source instanceof \Closure) {
            $this->source = $source;
        } elseif ($source === null) {
            $this->source = fn (): array => [];
        } elseif ($source instanceof LazyCollection) {
            $this->source = $source->source;
        } else {
            $items = $source instanceof Collection ? $source->all() : $source;
            $this->source = function () use ($items): \Generator { yield from $items; };
        }
    }

    public static function make(mixed $items = []): static { return new static($items); }
    public static function empty(): static { return new static([]); }

    public static function range(int $from, int $to, int $step = 1): static
    {
        return new static(function () use ($from, $to, $step): \Generator {
            if ($from <= $to) {
                for (; $from <= $to; $from += abs($step)) { yield $from; }
            } else {
                for (; $from >= $to; $from -= abs($step)) { yield $from; }
            }
        });
    }

    public static function times(int $number, ?callable $callback = null): static
    {
        return new static(function () use ($number, $callback): \Generator {
            for ($i = 1; $i <= $number; $i++) { yield $callback === null ? $i : $callback($i); }
        });
    }

    public function getIterator(): \Iterator
    {
        $iter = ($this->source)();
        return $iter instanceof \Iterator ? $iter : new \ArrayIterator($iter);
    }

    protected function valueRetriever(mixed $value): \Closure
    {
        if ($value instanceof \Closure) { return $value; }
        if ($value === null) { return fn (mixed $item): mixed => $item; }
        return fn (mixed $item): mixed => data_get($item, $value);
    }

    // ---- lazy transforms ---------------------------------------------------

    public function map(callable $callback): static
    {
        return new static(function () use ($callback): \Generator {
            foreach ($this as $k => $v) { yield $k => $callback($v, $k); }
        });
    }

    public function mapWithKeys(callable $callback): static
    {
        return new static(function () use ($callback): \Generator {
            foreach ($this as $k => $v) { yield from $callback($v, $k); }
        });
    }

    public function filter(?callable $callback = null): static
    {
        return new static(function () use ($callback): \Generator {
            foreach ($this as $k => $v) {
                if ($callback === null ? (bool) $v : $callback($v, $k)) { yield $k => $v; }
            }
        });
    }

    public function reject(callable $callback): static { return $this->filter(fn (mixed $v, string|int $k): bool => !$callback($v, $k)); }

    public function where(string $key, mixed $operator = null, mixed $value = null): static
    {
        $args = func_get_args();
        return new static(function () use ($args): \Generator {
            $kept = (new Collection(iterator_to_array($this)))->where(...$args);
            yield from $kept->all();
        });
    }

    public function whereNotNull(?string $key = null): static { return $this->filter(fn (mixed $v): bool => ($key === null ? $v : data_get($v, $key)) !== null); }

    public function pluck(string $value, ?string $key = null): static
    {
        return new static(function () use ($value, $key): \Generator {
            foreach ($this as $item) {
                if ($key === null) { yield data_get($item, $value); } else { yield data_get($item, $key) => data_get($item, $value); }
            }
        });
    }

    public function keys(): static
    {
        return new static(function (): \Generator {
            foreach ($this as $k => $_) { yield $k; }
        });
    }

    public function values(): static
    {
        return new static(function (): \Generator {
            foreach ($this as $v) { yield $v; }
        });
    }

    public function flip(): static
    {
        return new static(function (): \Generator {
            foreach ($this as $k => $v) { yield $v => $k; }
        });
    }

    public function take(int $limit): static
    {
        if ($limit < 0) { return new static(fn (): array => (new Collection(iterator_to_array($this)))->take($limit)->all()); }
        return new static(function () use ($limit): \Generator {
            if ($limit === 0) { return; }
            $n = 0;
            foreach ($this as $k => $v) {
                yield $k => $v;
                if (++$n >= $limit) { break; }
            }
        });
    }

    public function takeUntil(mixed $value): static
    {
        $test = $value instanceof \Closure ? $value : fn (mixed $item): bool => $item === $value;
        return new static(function () use ($test): \Generator {
            foreach ($this as $k => $v) {
                if ($test($v, $k)) { break; }
                yield $k => $v;
            }
        });
    }

    public function takeWhile(mixed $value): static
    {
        $test = $value instanceof \Closure ? $value : fn (mixed $item): bool => $item === $value;
        return $this->takeUntil(fn (mixed $v, string|int $k): bool => !$test($v, $k));
    }

    public function skip(int $count): static
    {
        return new static(function () use ($count): \Generator {
            $n = 0;
            foreach ($this as $k => $v) {
                if ($n++ >= $count) { yield $k => $v; }
            }
        });
    }

    public function skipUntil(mixed $value): static
    {
        $test = $value instanceof \Closure ? $value : fn (mixed $item): bool => $item === $value;
        return new static(function () use ($test): \Generator {
            $taking = false;
            foreach ($this as $k => $v) {
                if (!$taking && $test($v, $k)) { $taking = true; }
                if ($taking) { yield $k => $v; }
            }
        });
    }

    public function skipWhile(mixed $value): static
    {
        $test = $value instanceof \Closure ? $value : fn (mixed $item): bool => $item === $value;
        return $this->skipUntil(fn (mixed $v, string|int $k): bool => !$test($v, $k));
    }

    public function chunk(int $size): static
    {
        if ($size <= 0) { return static::empty(); }
        return new static(function () use ($size): \Generator {
            $chunk = [];
            foreach ($this as $k => $v) {
                $chunk[$k] = $v;
                if (count($chunk) === $size) {
                    yield new static($chunk);
                    $chunk = [];
                }
            }
            if ($chunk !== []) { yield new static($chunk); }
        });
    }

    public function flatMap(callable $callback): static
    {
        return new static(function () use ($callback): \Generator {
            foreach ($this as $k => $v) {
                foreach ($callback($v, $k) as $item) { yield $item; }
            }
        });
    }

    public function collapse(): static
    {
        return new static(function (): \Generator {
            foreach ($this as $values) {
                foreach ($values as $v) { yield $v; }
            }
        });
    }

    public function unique(string|callable|null $key = null): static
    {
        $retrieve = $this->valueRetriever($key);
        return new static(function () use ($retrieve): \Generator {
            $seen = [];
            foreach ($this as $k => $v) {
                $id = $retrieve($v, $k);
                $marker = is_array($id) || is_object($id) ? serialize($id) : var_export($id, true);
                if (!array_key_exists($marker, $seen)) {
                    $seen[$marker] = true;
                    yield $k => $v;
                }
            }
        });
    }

    public function concat(iterable $source): static
    {
        return new static(function () use ($source): \Generator {
            foreach ($this as $v) { yield $v; }
            foreach ($source as $v) { yield $v; }
        });
    }

    public function tapEach(callable $callback): static
    {
        return new static(function () use ($callback): \Generator {
            foreach ($this as $k => $v) {
                $callback($v, $k);
                yield $k => $v;
            }
        });
    }

    public function zip(iterable ...$items): static
    {
        return new static(function () use ($items): \Generator {
            $arrays = array_map(fn (iterable $i): array => array_values(is_array($i) ? $i : iterator_to_array($i)), $items);
            $i = 0;
            foreach ($this as $v) {
                $row = [$v];
                foreach ($arrays as $a) { $row[] = $a[$i] ?? null; }
                yield new static($row);
                $i++;
            }
        });
    }

    /** Caches the values as they are first iterated (Laravel's remember). */
    public function remember(): static
    {
        $cache = new LazyCache();
        return new static(function () use ($cache): \Generator {
            $i = 0;
            while (true) {
                if ($i < count($cache->pairs)) {
                    yield $cache->pairs[$i][0] => $cache->pairs[$i][1];
                    $i++;
                    continue;
                }
                if ($cache->done) { return; }
                if ($cache->source === null) {
                    $cache->source = $this->getIterator();
                } else {
                    $cache->source->next();
                }
                if (!$cache->source->valid()) {
                    $cache->done = true;
                    return;
                }
                $cache->pairs[] = [$cache->source->key(), $cache->source->current()];
            }
        });
    }

    // ---- terminal operations -----------------------------------------------

    public function all(): array { return iterator_to_array($this); }
    public function toArray(): array { return $this->collect()->toArray(); }
    public function jsonSerialize(): array { return $this->collect()->jsonSerialize(); }
    public function toJson(int $options = 0): string { return json_encode($this->jsonSerialize(), $options); }
    public function collect(): Collection { return new Collection($this->all()); }
    public function eager(): static { return new static($this->all()); }

    public function count(): int
    {
        $n = 0;
        foreach ($this as $_) { $n++; }
        return $n;
    }

    public function isEmpty(): bool
    {
        foreach ($this as $_) { return false; }
        return true;
    }

    public function isNotEmpty(): bool { return !$this->isEmpty(); }

    public function first(?callable $callback = null, mixed $default = null): mixed
    {
        foreach ($this as $k => $v) {
            if ($callback === null || $callback($v, $k)) { return $v; }
        }
        return $default instanceof \Closure ? $default() : $default;
    }

    public function last(?callable $callback = null, mixed $default = null): mixed
    {
        $found = false;
        $last = null;
        foreach ($this as $k => $v) {
            if ($callback === null || $callback($v, $k)) {
                $found = true;
                $last = $v;
            }
        }
        return $found ? $last : ($default instanceof \Closure ? $default() : $default);
    }

    public function each(callable $callback): static
    {
        foreach ($this as $k => $v) {
            if ($callback($v, $k) === false) { break; }
        }
        return $this;
    }

    public function contains(mixed $key, mixed $operator = null, mixed $value = null): bool
    {
        if (func_num_args() === 1 && $key instanceof \Closure) {
            foreach ($this as $k => $v) {
                if ($key($v, $k)) { return true; }
            }
            return false;
        }
        if (func_num_args() === 1) {
            foreach ($this as $v) {
                if ($v === $key) { return true; }
            }
            return false;
        }
        return $this->collect()->contains(...func_get_args());
    }

    public function every(callable $callback): bool
    {
        foreach ($this as $k => $v) {
            if (!$callback($v, $k)) { return false; }
        }
        return true;
    }

    public function reduce(callable $callback, mixed $initial = null): mixed
    {
        $result = $initial;
        foreach ($this as $k => $v) { $result = $callback($result, $v, $k); }
        return $result;
    }

    public function sum(string|callable|null $callback = null): int|float { return $this->collect()->sum($callback); }
    public function avg(string|callable|null $callback = null): int|float|null { return $this->collect()->avg($callback); }
    public function min(string|callable|null $callback = null): mixed { return $this->collect()->min($callback); }
    public function max(string|callable|null $callback = null): mixed { return $this->collect()->max($callback); }
    public function implode(string $value, ?string $glue = null): string { return $this->collect()->implode($value, $glue); }
    public function join(string $glue, string $finalGlue = ''): string { return $this->collect()->join($glue, $finalGlue); }
    public function groupBy(string|callable $groupBy): Collection { return $this->collect()->groupBy($groupBy); }
    public function keyBy(string|callable $keyBy): static { return new static($this->collect()->keyBy($keyBy)->all()); }
    public function sort(?callable $callback = null): static { return new static($this->collect()->sort($callback)->all()); }
    public function sortBy(string|callable|null $callback = null, bool $descending = false): static { return new static($this->collect()->sortBy($callback, $descending)->all()); }
    public function reverse(): static { return new static($this->collect()->reverse()->all()); }
}

/** @internal State of LazyCollection::remember, shared by its generators. */
final class LazyCache
{
    public array $pairs = [];
    public bool $done = false;
    public ?\Iterator $source = null;
}

class Stringable implements \JsonSerializable, \ArrayAccess, \Stringable
{
    public function __construct(protected string $value = '') {}

    // ---- steps that give a new string ---------------------------------------
    public function after(string $search): static { return new static(Str::after($this->value, $search)); }
    public function afterLast(string $search): static { return new static(Str::afterLast($this->value, $search)); }
    public function append(string ...$values): static { return new static($this->value . implode('', $values)); }
    public function prepend(string ...$values): static { return new static(implode('', $values) . $this->value); }
    public function basename(string $suffix = ''): static
    {
        $base = (string) preg_replace('~^.*/~', '', rtrim($this->value, '/'));
        if ($suffix !== '' && str_ends_with($base, $suffix) && $base !== $suffix) { $base = substr($base, 0, -strlen($suffix)); }
        return new static($base);
    }
    public function dirname(int $levels = 1): static
    {
        $path = $this->value;
        for ($i = 0; $i < $levels; $i++) {
            $trimmed = rtrim($path, '/');
            $pos = strrpos($trimmed, '/');
            $path = $pos === false ? '.' : ($pos === 0 ? '/' : substr($trimmed, 0, $pos));
        }
        return new static($path);
    }
    public function classBasename(): static { return new static((string) preg_replace('~^.*\\\\~', '', str_replace('/', '\\', $this->value))); }
    public function before(string $search): static { return new static(Str::before($this->value, $search)); }
    public function beforeLast(string $search): static { return new static(Str::beforeLast($this->value, $search)); }
    public function between(string $from, string $to): static { return new static(Str::between($this->value, $from, $to)); }
    public function betweenFirst(string $from, string $to): static { return new static(Str::betweenFirst($this->value, $from, $to)); }
    public function camel(): static { return new static(Str::camel($this->value)); }
    public function chopStart(string|array $needle): static { return new static(Str::chopStart($this->value, $needle)); }
    public function chopEnd(string|array $needle): static { return new static(Str::chopEnd($this->value, $needle)); }
    public function convertCase(int $mode = MB_CASE_FOLD): static { return new static(Str::convertCase($this->value, $mode)); }
    public function deduplicate(string|array $characters = ' '): static { return new static(Str::deduplicate($this->value, $characters)); }
    public function finish(string $cap): static { return new static(Str::finish($this->value, $cap)); }
    public function kebab(): static { return new static(Str::kebab($this->value)); }
    public function limit(int $limit = 100, string $end = '...'): static { return new static(Str::limit($this->value, $limit, $end)); }
    public function lower(): static { return new static(Str::lower($this->value)); }
    public function mask(string $character, int $index, ?int $length = null): static { return new static(Str::mask($this->value, $character, $index, $length)); }
    public function match(string $pattern): static { return new static(Str::match($pattern, $this->value)); }
    public function numbers(): static { return new static(Str::numbers($this->value)); }
    public function padBoth(int $length, string $pad = ' '): static { return new static(Str::padBoth($this->value, $length, $pad)); }
    public function padLeft(int $length, string $pad = ' '): static { return new static(Str::padLeft($this->value, $length, $pad)); }
    public function padRight(int $length, string $pad = ' '): static { return new static(Str::padRight($this->value, $length, $pad)); }
    public function pipe(callable $callback): static { return new static((string) $callback($this)); }
    public function plural(int|array|\Countable $count = 2): static { return new static(Str::plural($this->value, $count)); }
    public function pluralStudly(int|array|\Countable $count = 2): static { return new static(Str::pluralStudly($this->value, $count)); }
    public function pluralPascal(int|array|\Countable $count = 2): static { return new static(Str::pluralStudly($this->value, $count)); }
    public function remove(string|array $search, bool $caseSensitive = true): static { return new static(Str::remove($search, $this->value, $caseSensitive)); }
    public function reverse(): static { return new static(Str::reverse($this->value)); }
    public function repeat(int $times): static { return new static(str_repeat($this->value, $times)); }
    public function replace(string|array $search, string|array $replace, bool $caseSensitive = true): static
    {
        return new static($caseSensitive ? str_replace($search, $replace, $this->value) : str_ireplace($search, $replace, $this->value));
    }
    public function replaceArray(string $search, array $replace): static { return new static(Str::replaceArray($search, $replace, $this->value)); }
    public function replaceFirst(string $search, string $replace): static { return new static(Str::replaceFirst($search, $replace, $this->value)); }
    public function replaceStart(string $search, string $replace): static { return new static(Str::replaceStart($search, $replace, $this->value)); }
    public function replaceLast(string $search, string $replace): static { return new static(Str::replaceLast($search, $replace, $this->value)); }
    public function replaceEnd(string $search, string $replace): static { return new static(Str::replaceEnd($search, $replace, $this->value)); }
    public function replaceMatches(string|array $pattern, string|array $replace, int $limit = -1): static { return new static(Str::replaceMatches($pattern, $replace, $this->value, $limit)); }
    public function squish(): static { return new static(Str::squish($this->value)); }
    public function start(string $prefix): static { return new static(Str::start($this->value, $prefix)); }
    public function stripTags(?string $allowedTags = null): static { return new static($allowedTags === null ? strip_tags($this->value) : strip_tags($this->value, $allowedTags)); }
    public function upper(): static { return new static(Str::upper($this->value)); }
    public function title(): static { return new static(Str::title($this->value)); }
    public function headline(): static { return new static(Str::headline($this->value)); }
    public function initials(bool $capitalize = false): static { return new static(Str::initials($this->value, $capitalize)); }
    public function apa(): static { return new static(Str::apa($this->value)); }
    public function singular(): static { return new static(Str::singular($this->value)); }
    public function slug(string $separator = '-'): static { return new static(Str::slug($this->value, $separator)); }
    public function snake(string $delimiter = '_'): static { return new static(Str::snake($this->value, $delimiter)); }
    public function studly(): static { return new static(Str::studly($this->value)); }
    public function pascal(): static { return new static(Str::pascal($this->value)); }
    public function substr(int $start, ?int $length = null): static { return new static(Str::substr($this->value, $start, $length)); }
    public function substrReplace(string $replace, int $offset = 0, ?int $length = null): static { return new static(Str::substrReplace($this->value, $replace, $offset, $length)); }
    public function swap(array $map): static { return new static(strtr($this->value, $map)); }
    public function take(int $limit): static { return new static(Str::take($this->value, $limit)); }
    public function trim(?string $characters = null): static { return new static(Str::trim($this->value, $characters)); }
    public function ltrim(?string $characters = null): static { return new static(Str::ltrim($this->value, $characters)); }
    public function rtrim(?string $characters = null): static { return new static(Str::rtrim($this->value, $characters)); }
    public function lcfirst(): static { return new static(Str::lcfirst($this->value)); }
    public function ucfirst(): static { return new static(Str::ucfirst($this->value)); }
    public function ucwords(string $separators = " \t\r\n\f\v"): static { return new static(Str::ucwords($this->value, $separators)); }
    public function words(int $words = 100, string $end = '...'): static { return new static(Str::words($this->value, $words, $end)); }
    public function wordWrap(int $characters = 75, string $break = "\n", bool $cutLongWords = false): static { return new static(Str::wordWrap($this->value, $characters, $break, $cutLongWords)); }
    public function wrap(string $before, ?string $after = null): static { return new static(Str::wrap($this->value, $before, $after)); }
    public function unwrap(string $before, ?string $after = null): static { return new static(Str::unwrap($this->value, $before, $after)); }
    public function toBase64(): static { return new static(base64_encode($this->value)); }
    public function fromBase64(bool $strict = false): static { return new static((string) base64_decode($this->value, $strict)); }
    public function hash(string $algorithm): static { return new static(hash($algorithm, $this->value)); }
    public function newLine(int $count = 1): static { return $this->append(str_repeat(PHP_EOL, $count)); }

    // ---- questions ----------------------------------------------------------
    public function charAt(int $index): string|false { return Str::charAt($this->value, $index); }
    public function contains(string|iterable $needles, bool $ignoreCase = false): bool { return Str::contains($this->value, is_string($needles) ? $needles : iterator_to_array_values($needles), $ignoreCase); }
    public function containsAll(iterable $needles, bool $ignoreCase = false): bool { return Str::containsAll($this->value, iterator_to_array_values($needles), $ignoreCase); }
    public function doesntContain(string|iterable $needles, bool $ignoreCase = false): bool { return !$this->contains($needles, $ignoreCase); }
    public function endsWith(string|iterable $needles): bool { return Str::endsWith($this->value, is_string($needles) ? $needles : iterator_to_array_values($needles)); }
    public function doesntEndWith(string|iterable $needles): bool { return !$this->endsWith($needles); }
    public function startsWith(string|iterable $needles): bool { return Str::startsWith($this->value, is_string($needles) ? $needles : iterator_to_array_values($needles)); }
    public function doesntStartWith(string|iterable $needles): bool { return !$this->startsWith($needles); }
    public function exactly(mixed $value): bool { return ($value instanceof Stringable ? $value->toString() : $value) === $this->value; }
    public function excerpt(string $phrase = '', array $options = []): ?string { return Str::excerpt($this->value, $phrase, $options); }
    public function explode(string $delimiter, int $limit = PHP_INT_MAX): Collection { return new Collection(explode($delimiter, $this->value, $limit)); }
    public function split(string|int $pattern, int $limit = -1, int $flags = 0): Collection
    {
        if (is_int($pattern)) { return new Collection(mb_str_split($this->value, $pattern)); }
        $parts = preg_split($pattern, $this->value, $limit, $flags);
        return new Collection($parts === false ? [] : $parts);
    }
    public function is(string|iterable $pattern): bool { return Str::is(is_string($pattern) ? $pattern : iterator_to_array_values($pattern), $this->value); }
    public function isAscii(): bool { return Str::isAscii($this->value); }
    public function isJson(): bool { return Str::isJson($this->value); }
    public function isUrl(array $protocols = []): bool { return Str::isUrl($this->value, $protocols); }
    public function isUuid(): bool { return Str::isUuid($this->value); }
    public function isEmpty(): bool { return $this->value === ''; }
    public function isNotEmpty(): bool { return $this->value !== ''; }
    public function length(): int { return Str::length($this->value); }
    public function isMatch(string|iterable $pattern): bool { return Str::isMatch(is_string($pattern) ? $pattern : iterator_to_array_values($pattern), $this->value); }
    public function matchAll(string $pattern): Collection { return Str::matchAll($pattern, $this->value); }
    public function test(string $pattern): bool { return $this->isMatch($pattern); }
    public function position(string $needle, int $offset = 0): int|false { return Str::position($this->value, $needle, $offset); }
    public function substrCount(string $needle, int $offset = 0, ?int $length = null): int { return Str::substrCount($this->value, $needle, $offset, $length); }
    public function ucsplit(): Collection { return new Collection(Str::ucsplit($this->value)); }
    public function wordCount(?string $characters = null): int { return Str::wordCount($this->value, $characters); }

    // ---- conditions (Laravel's Conditionable and the when* helpers) ---------
    public function when(mixed $value = null, ?callable $callback = null, ?callable $default = null): mixed
    {
        $value = $value instanceof \Closure ? $value($this) : $value;
        if ($value) { return $callback === null ? $this : ($callback($this, $value) ?? $this); }
        return $default === null ? $this : ($default($this, $value) ?? $this);
    }
    public function unless(mixed $value = null, ?callable $callback = null, ?callable $default = null): mixed
    {
        $value = $value instanceof \Closure ? $value($this) : $value;
        if (!$value) { return $callback === null ? $this : ($callback($this, $value) ?? $this); }
        return $default === null ? $this : ($default($this, $value) ?? $this);
    }
    public function whenContains(string|iterable $needles, callable $callback, ?callable $default = null): mixed { return $this->when($this->contains($needles), $callback, $default); }
    public function whenContainsAll(array $needles, callable $callback, ?callable $default = null): mixed { return $this->when($this->containsAll($needles), $callback, $default); }
    public function whenEmpty(callable $callback, ?callable $default = null): mixed { return $this->when($this->isEmpty(), $callback, $default); }
    public function whenNotEmpty(callable $callback, ?callable $default = null): mixed { return $this->when($this->isNotEmpty(), $callback, $default); }
    public function whenEndsWith(string|iterable $needles, callable $callback, ?callable $default = null): mixed { return $this->when($this->endsWith($needles), $callback, $default); }
    public function whenDoesntEndWith(string|iterable $needles, callable $callback, ?callable $default = null): mixed { return $this->when($this->doesntEndWith($needles), $callback, $default); }
    public function whenExactly(string $value, callable $callback, ?callable $default = null): mixed { return $this->when($this->exactly($value), $callback, $default); }
    public function whenNotExactly(string $value, callable $callback, ?callable $default = null): mixed { return $this->when(!$this->exactly($value), $callback, $default); }
    public function whenIs(string|iterable $pattern, callable $callback, ?callable $default = null): mixed { return $this->when($this->is($pattern), $callback, $default); }
    public function whenIsAscii(callable $callback, ?callable $default = null): mixed { return $this->when($this->isAscii(), $callback, $default); }
    public function whenIsUuid(callable $callback, ?callable $default = null): mixed { return $this->when($this->isUuid(), $callback, $default); }
    public function whenStartsWith(string|iterable $needles, callable $callback, ?callable $default = null): mixed { return $this->when($this->startsWith($needles), $callback, $default); }
    public function whenDoesntStartWith(string|iterable $needles, callable $callback, ?callable $default = null): mixed { return $this->when($this->doesntStartWith($needles), $callback, $default); }
    public function whenTest(string $pattern, callable $callback, ?callable $default = null): mixed { return $this->when($this->test($pattern), $callback, $default); }
    public function tap(callable $callback): static { $callback($this); return $this; }

    // ---- values -------------------------------------------------------------
    public function value(): string { return $this->value; }
    public function toString(): string { return $this->value; }
    public function toInteger(int $base = 10): int { return intval($this->value, $base); }
    public function toFloat(): float { return floatval($this->value); }
    public function toBoolean(): bool { return filter_var($this->value, FILTER_VALIDATE_BOOLEAN); }
    public function jsonSerialize(): string { return $this->value; }
    public function __toString(): string { return $this->value; }
    public function offsetExists(mixed $offset): bool { return isset($this->value[$offset]); }
    public function offsetGet(mixed $offset): string { return $this->value[$offset]; }
    public function offsetSet(mixed $offset, mixed $value): void { throw new \LogicException('Stringable is immutable'); }
    public function offsetUnset(mixed $offset): void { throw new \LogicException('Stringable is immutable'); }
}

/** The values of an iterable as a list (for the needles of Stringable). */
function iterator_to_array_values(iterable $values): array
{
    $out = [];
    foreach ($values as $v) { $out[] = $v; }
    return $out;
}

/** First value of an array (no internal pointer in the dialect). */
function reset_value(array $a): mixed { return $a === [] ? null : $a[array_key_first($a)]; }

/** Last value of an array. */
function end_value(array $a): mixed { return $a === [] ? null : $a[array_key_last($a)]; }

class ItemNotFoundException extends \RuntimeException {}

class MultipleItemsFoundException extends \RuntimeException
{
    public function __construct(public int $count = 0)
    {
        parent::__construct("{$count} items were found.");
    }
}

